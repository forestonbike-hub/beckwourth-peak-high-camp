---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "60-acre glampsite on Beckwourth Peak, in the heart of the Lost Sierra. Hiking, mountain bike trails, and gravel rides. Cabins and yurt with amazing views, A/C and hot showers.",
  image = "https://beckwourthpeakhighcamp.com/wp-content/uploads/2024/05/beckwourth-high-camp-3379-ig_53695514700_o-2.jpg",
} = Astro.props;

const siteTitle = title === "Home"
  ? "High Camp | Beckwourth Peak Trail & The Lost Sierra"
  : `${title} | Beckwourth Peak High Camp`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="https://beckwourthpeakhighcamp.com/wp-content/uploads/2023/02/cropped-Symbol-525x525-1-32x32.png" />
  </head>
  <body class="bg-white">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
