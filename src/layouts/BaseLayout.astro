---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Off-grid glamping on Beckwourth Peak (5,300 ft) in the Lost Sierra. Cabins, yurt, and campsite with hot showers, Starlink WiFi, and 360-degree mountain views. Gravel biking, hiking, mountain biking.",
  image = "https://beckwourthpeakhighcamp.com/wp-content/uploads/2024/05/beckwourth-high-camp-3379-ig_53695514700_o-2.jpg",
} = Astro.props;

const siteTitle = title === "Home"
  ? "Beckwourth Peak High Camp | Off-Grid Glamping with Starlink in the Lost Sierra"
  : `${title} | Beckwourth Peak High Camp`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800&family=Lato:wght@400;700;900&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="https://beckwourthpeakhighcamp.com/wp-content/uploads/2023/02/cropped-Symbol-525x525-1-32x32.png" />
  </head>
  <body class="bg-brand-offwhite text-brand-black">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
