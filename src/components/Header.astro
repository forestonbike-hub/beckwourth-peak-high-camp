---
const BOOK_NOW_URL = "https://resnexus.com/resnexus/reservations/book/6C664BF8-3F89-4D87-9E83-DA82447501EB/?NewSearch=1&nights=2&adults=2&startdate=5%2F1%2F2024";

const navLinks = [
  { label: "Lodging", href: "/lodging/" },
  {
    label: "Things To Do",
    href: "/things-to-do/",
    children: [
      { label: "Mountain Biking", href: "/trails/mountain-biking/" },
      { label: "Gravel Biking", href: "/trails/gravel-biking/" },
      { label: "Hiking", href: "/trails/hiking/" },
      { label: "Bikepacking Routes", href: "/trails/bikepacking-routes/" },
      { label: "CABDR-North Alternate", href: "/trails/cabdr-north-alternate/" },
    ],
  },
  { label: "Getting Here", href: "/getting-here/" },
  { label: "Policies", href: "/policies/" },
];
---

<header class="bg-brand-black text-white sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
    <!-- Logo / Site Name -->
    <a href="/" class="flex items-center gap-3 group">
      <img
        src="https://beckwourthpeakhighcamp.com/wp-content/uploads/2023/02/cropped-Symbol-525x525-1-32x32.png"
        alt="High Camp logo"
        width="36"
        height="36"
        class="rounded-sm"
      />
      <span class="hidden sm:block font-heading font-bold text-lg text-white group-hover:text-brand-gold transition-colors leading-tight">
        Beckwourth Peak High Camp
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-7">
      {navLinks.map((link) =>
        link.children ? (
          <div class="relative group">
            <a
              href={link.href}
              class="font-sans font-bold text-sm uppercase tracking-wider text-white/90 hover:text-brand-gold transition-colors flex items-center gap-1"
            >
              {link.label}
              <svg class="w-3 h-3 mt-0.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <div class="absolute top-full left-0 mt-2 w-56 bg-white text-brand-black rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 border border-brand-sage overflow-hidden">
              {link.children.map((child) => (
                <a
                  href={child.href}
                  class="block px-5 py-3 text-sm font-sans hover:bg-brand-sage hover:text-brand-green transition-colors"
                >
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            class="font-sans font-bold text-sm uppercase tracking-wider text-white/90 hover:text-brand-gold transition-colors"
          >
            {link.label}
          </a>
        )
      )}
      <a
        href={BOOK_NOW_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-brand-green hover:bg-brand-green-dark text-white font-sans font-bold text-sm px-5 py-2.5 rounded-md transition-colors"
      >
        Book Now
      </a>
    </nav>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="lg:hidden text-white p-2"
      aria-label="Open menu"
    >
      <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Nav Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden bg-brand-black border-t border-white/10 px-4 pb-6">
    {navLinks.map((link) => (
      <div>
        <a
          href={link.href}
          class="block py-3 font-sans font-bold text-sm uppercase tracking-wider text-white/90 border-b border-white/10"
        >
          {link.label}
        </a>
        {link.children && link.children.map((child) => (
          <a
            href={child.href}
            class="block py-2.5 pl-5 text-sm text-white/60 hover:text-brand-gold border-b border-white/5 transition-colors"
          >
            {child.label}
          </a>
        ))}
      </div>
    ))}
    <a
      href={BOOK_NOW_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="block mt-5 bg-brand-green text-white text-center font-sans font-bold py-3 rounded-md"
    >
      Book Now
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    menuIcon?.classList.toggle('hidden', !isOpen);
    closeIcon?.classList.toggle('hidden', isOpen);
  });
</script>
