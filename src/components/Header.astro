---
const BOOK_NOW_URL = "https://resnexus.com/resnexus/reservations/book/6C664BF8-3F89-4D87-9E83-DA82447501EB/?NewSearch=1&nights=2&adults=2&startdate=5%2F1%2F2024";

const navLinks = [
  { label: "Lodging", href: "/lodging/" },
  {
    label: "Trails",
    href: "/trails/",
    children: [
      { label: "Mountain Biking", href: "/trails/mountain-biking/" },
      { label: "Gravel Biking", href: "/trails/gravel-biking/" },
      { label: "Hiking", href: "/trails/hiking/" },
      { label: "Bikepacking Routes", href: "/trails/bikepacking-routes/" },
      { label: "CABDR-North Alternate", href: "/trails/cabdr-north-alternate/" },
    ],
  },
  { label: "Things To Do", href: "/things-to-do/" },
  { label: "Getting Here", href: "/getting-here/" },
  { label: "Policies", href: "/policies/" },
];
---

<header class="bg-[#010000] text-white sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
    <!-- Logo / Site Name -->
    <a href="/" class="flex items-center gap-2 font-heading font-bold text-white text-lg leading-tight hover:text-gray-200 transition-colors">
      <img
        src="https://beckwourthpeakhighcamp.com/wp-content/uploads/2023/02/cropped-Symbol-525x525-1-32x32.png"
        alt="High Camp logo"
        width="32"
        height="32"
        class="rounded-sm"
      />
      <span class="hidden sm:block">Beckwourth Peak High Camp</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-6">
      {navLinks.map((link) =>
        link.children ? (
          <div class="relative group">
            <a
              href={link.href}
              class="font-heading font-semibold text-sm uppercase text-[#046bd2] hover:text-blue-300 transition-colors flex items-center gap-1"
            >
              {link.label}
              <svg class="w-3 h-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <div class="absolute top-full left-0 mt-1 w-52 bg-white text-slate-800 rounded shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
              {link.children.map((child) => (
                <a
                  href={child.href}
                  class="block px-4 py-2 text-sm font-heading hover:bg-slate-100 hover:text-[#046bd2] transition-colors"
                >
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            class="font-heading font-semibold text-sm uppercase text-[#046bd2] hover:text-blue-300 transition-colors"
          >
            {link.label}
          </a>
        )
      )}
      <a
        href={BOOK_NOW_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#046bd2] hover:bg-blue-700 text-white font-heading font-semibold text-sm px-4 py-2 rounded-md transition-colors"
      >
        Book Now
      </a>
    </nav>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="lg:hidden text-white p-2"
      aria-label="Open menu"
    >
      <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Nav Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden bg-[#010000] border-t border-gray-800 px-4 pb-4">
    {navLinks.map((link) => (
      <div>
        <a
          href={link.href}
          class="block py-2 font-heading font-semibold text-sm uppercase text-[#046bd2] border-b border-gray-800"
        >
          {link.label}
        </a>
        {link.children && link.children.map((child) => (
          <a
            href={child.href}
            class="block py-2 pl-4 text-sm text-gray-300 hover:text-white border-b border-gray-900"
          >
            {child.label}
          </a>
        ))}
      </div>
    ))}
    <a
      href={BOOK_NOW_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="block mt-4 bg-[#046bd2] text-white text-center font-heading font-semibold py-3 rounded-md"
    >
      Book Now
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    menuIcon?.classList.toggle('hidden', !isOpen);
    closeIcon?.classList.toggle('hidden', isOpen);
  });
</script>
