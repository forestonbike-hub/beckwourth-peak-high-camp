---
const currentYear = new Date().getFullYear();
const BOOK_NOW_URL = "https://resnexus.com/resnexus/reservations/book/6C664BF8-3F89-4D87-9E83-DA82447501EB/?NewSearch=1&nights=2&adults=2&startdate=5%2F1%2F2024";
---

<footer class="bg-brand-black text-white/90 mt-0">
  <div class="max-w-7xl mx-auto px-6 py-14">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 text-center sm:text-left">
      <!-- Contact -->
      <div>
        <h3 class="font-heading font-bold text-xl mb-4 text-brand-gold">Contact</h3>
        <p class="text-sm mb-2">
          <a href="mailto:contact@beckwourthpeakhighcamp.com" class="hover:text-brand-gold transition-colors">
            contact@beckwourthpeakhighcamp.com
          </a>
        </p>
        <p class="text-sm mb-2">
          <a href="tel:5303220322" class="hover:text-brand-gold transition-colors">530-322-0322</a>
        </p>
        <p class="text-sm mt-3">
          <a
            href="https://maps.app.goo.gl/MSkfn5p7jGKK6w6e8"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-brand-gold transition-colors inline-flex items-center gap-1"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            Get directions on Google Maps
          </a>
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-heading font-bold text-xl mb-4 text-brand-gold">Quick Links</h3>
        <ul class="text-sm space-y-2">
          <li><a href="/lodging/" class="hover:text-brand-gold transition-colors">Lodging</a></li>
          <li><a href="/trails/" class="hover:text-brand-gold transition-colors">Trails &amp; Routes</a></li>
          <li><a href="/things-to-do/" class="hover:text-brand-gold transition-colors">Things To Do</a></li>
          <li><a href="/getting-here/" class="hover:text-brand-gold transition-colors">Getting Here</a></li>
          <li><a href="/policies/" class="hover:text-brand-gold transition-colors">Policies</a></li>
        </ul>
      </div>

      <!-- Social / Booking -->
      <div>
        <h3 class="font-heading font-bold text-xl mb-4 text-brand-gold">Book Your Stay</h3>
        <a
          href={BOOK_NOW_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-brand-green hover:bg-brand-green-dark text-white font-sans font-bold px-6 py-2.5 rounded-md transition-colors text-sm"
        >
          Book Now
        </a>
        <p class="text-sm mt-4">
          <a
            href="https://www.instagram.com/beckwourthpeakhighcamp/"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-brand-gold transition-colors inline-flex items-center gap-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            @beckwourthpeakhighcamp
          </a>
        </p>
      </div>
    </div>

    <div class="border-t border-white/10 mt-10 pt-6 text-center text-sm text-white/50">
      &copy; {currentYear} Beckwourth Peak High Camp. All rights reserved.
    </div>
  </div>
</footer>
