---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const BOOK_URL = 'https://resnexus.com/resnexus/reservations/book/6C664BF8-3F89-4D87-9E83-DA82447501EB/';
---

<Layout
  title="Sierra Valley Art & Ag Trail | Stay at High Camp | Sept 20, 2026"
  description="Attending the Sierra Valley Art & Ag Trail festival? High Camp is just 14 minutes from Sierra Valley Farms. Off-grid cabins, yurt, and campsite near Portola, CA."
  ogImage="/images/events/high-camp-cabins-dusk-evening-blue-sky.jpg"
>
  <Nav />

  <!-- HERO -->
  <section class="relative h-[55vh] min-h-[400px] flex items-end overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/images/events/high-camp-cabins-dusk-evening-blue-sky.jpg')"
    ></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-transparent"></div>
    <div class="relative z-10 max-w-8xl mx-auto px-6 pb-12 w-full">
      <p class="text-gold font-heading text-sm font-bold uppercase tracking-widest mb-2">September 20, 2026</p>
      <h1 class="font-heading text-5xl md:text-7xl font-bold uppercase tracking-wide text-white leading-none mb-3">Sierra Valley<br>Art & Ag Trail</h1>
      <p class="text-white/80 font-sans text-xl mb-8">14 Minutes from Sierra Valley Farms &bull; Lost Sierra, CA</p>
      <a href={BOOK_URL} target="_blank" rel="noopener" class="inline-block bg-cobalt hover:bg-blue-600 text-white font-heading font-bold uppercase tracking-widest px-8 py-4 transition-colors">
        Check Availability
      </a>
    </div>
  </section>

  <!-- HOOK -->
  <section class="py-14 bg-cream border-b border-charcoal/10">
    <div class="max-w-8xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2">
          <p class="text-cobalt font-heading text-sm font-bold uppercase tracking-widest mb-3">Attending the Art & Ag Trail?</p>
          <h2 class="font-heading text-4xl font-bold uppercase tracking-wide text-charcoal mb-4">High Camp Is Your Base</h2>
          <p class="font-sans text-lg text-charcoal/80 leading-relaxed">
            We're 14 minutes from Sierra Valley Farms — the closest comfortable lodging near the festival. Stay the night before, the night after, or both. Come home from a full day on the trail to hot showers, a fire pit, and mountain views that make the drive worth it on their own.
          </p>
        </div>
        <div class="flex flex-col gap-3 md:items-end">
          <a href={BOOK_URL} target="_blank" rel="noopener" class="inline-block bg-cobalt hover:bg-blue-600 text-white font-heading font-bold uppercase tracking-widest px-8 py-4 transition-colors text-center">
            Check Availability
          </a>
          <p class="font-sans text-charcoal/50 text-sm text-center md:text-right">September 20, 2026 &bull; Portola, CA</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT THE FESTIVAL -->
  <section class="py-20 bg-white">
    <div class="max-w-8xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-cobalt font-heading text-sm font-bold uppercase tracking-widest mb-3">New to the Festival?</p>
          <h2 class="font-heading text-5xl font-bold uppercase tracking-wide text-charcoal mb-6">What Is the Art & Ag Trail?</h2>
          <p class="font-sans text-lg text-charcoal/80 leading-relaxed mb-4">
            The Sierra Valley Art & Agriculture Trail is an annual self-guided tour through one of California's most stunning high-altitude meadows. On September 20, 2026, the trail connects farms, ranches, art studios, and small producers across Sierra Valley — think alpacas, local honey, handmade quilts, ceramics, and fresh produce, all set against open grassland and jagged peaks.
          </p>
          <p class="font-sans text-lg text-charcoal/80 leading-relaxed mb-4">
            It's a relaxed, community-driven event that draws visitors from across Northern California for a day of discovery. Sierra Valley Farms is one of the main hubs. The whole loop takes a few hours at a comfortable pace, with plenty of stops to browse, taste, and meet the makers behind each spot.
          </p>
          <p class="font-sans text-lg text-charcoal/80 leading-relaxed mb-6">
            If you've never been to Sierra Valley, this is a great introduction to the area. And if you're already a regular, you know how far people drive to get out there — it's worth making a full weekend of it.
          </p>
          <a href="https://www.sierravalleyfarms.com" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-cobalt hover:text-blue-700 font-sans font-bold transition-colors">
            Learn more at Sierra Valley Farms →
          </a>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="overflow-hidden col-span-2 h-56">
            <img
              src="/images/events/sierra-valley-art-ag-trail-festival-route-map.png"
              alt="Sierra Valley Art and Agriculture Trail festival route map showing participating farms and studios"
              class="w-full h-full object-cover object-top"
            />
          </div>
          <div class="overflow-hidden h-48">
            <img
              src="/images/events/high-camp-trail-pine-forest-beckwourth-peak.jpg"
              alt="Dirt trail through pine forest near High Camp with snow-capped Beckwourth Peak in the distance"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="overflow-hidden h-48">
            <img
              src="/images/events/high-camp-cabin-window-mountain-sunrise.jpg"
              alt="Mountain views at sunrise framed through the large windows of a High Camp cabin"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROXIMITY + MAP -->
  <section class="py-20 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-cobalt font-heading text-sm font-bold uppercase tracking-widest mb-3">Location</p>
          <h2 class="font-heading text-5xl font-bold uppercase tracking-wide text-charcoal mb-6">14 Minutes from Sierra Valley Farms</h2>
          <p class="font-sans text-lg text-charcoal/80 leading-relaxed mb-4">
            High Camp sits just 7.4 miles — about 14 minutes — from Sierra Valley Farms, making us the closest comfortable lodging to the festival. Spend the day exploring the trail and come back to camp to unwind under some of the darkest skies in California.
          </p>
          <p class="font-sans text-lg text-charcoal/80 leading-relaxed mb-4">
            We're on 65 acres at the edge of the Plumas National Forest, with 360° mountain views, a shared bathhouse with hot showers, and a communal fire pit. September is one of the best months at High Camp — warm days, cool nights, and no crowds.
          </p>
          <p class="font-sans text-lg text-charcoal/80 leading-relaxed mb-8">
            We're accessed via a 1-mile dirt road off Highway 70 near Portola. High-clearance vehicles are recommended. Check-in is at 3pm, check-out at 11am.
          </p>
          <a href={BOOK_URL} target="_blank" rel="noopener" class="inline-block bg-cobalt hover:bg-blue-600 text-white font-heading font-bold uppercase tracking-widest px-8 py-4 transition-colors">
            Check Availability
          </a>
        </div>
        <div>
          <div class="shadow-lg overflow-hidden mb-4">
            <img
              src="/images/events/high-camp-to-sierra-valley-farms-distance.jpg"
              alt="Map showing High Camp is 14 minutes and 7.4 miles from Sierra Valley Farms"
              class="w-full"
            />
            <div class="bg-charcoal text-white text-center py-4">
              <p class="font-heading text-2xl font-bold uppercase tracking-wide">14 Min &bull; 7.4 Miles</p>
              <p class="font-sans text-white/60 text-sm">from Sierra Valley Farms</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PHOTO GALLERY -->
  <section class="py-20 bg-white">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-cobalt font-heading text-sm font-bold uppercase tracking-widest mb-2">The Property</p>
        <h2 class="font-heading text-4xl font-bold uppercase tracking-wide text-charcoal">What Awaits at High Camp</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
        <div class="overflow-hidden h-64 lg:col-span-2">
          <img
            src="/images/events/high-camp-cabins-dusk-evening-blue-sky.jpg"
            alt="High Camp cabins glowing against a dramatic dusk sky surrounded by pines"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
          />
        </div>
        <div class="overflow-hidden h-64">
          <img
            src="/images/events/high-camp-aerial-beckwourth-peak-property.jpg"
            alt="Aerial view of High Camp nestled on Beckwourth Peak in the Lost Sierra"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
          />
        </div>
        <div class="overflow-hidden h-64">
          <img
            src="/images/events/high-camp-cabin-window-mountain-sunrise.jpg"
            alt="Mountain views at sunrise through the large windows of a High Camp cabin"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
          />
        </div>
        <div class="overflow-hidden h-64 lg:col-span-2">
          <img
            src="/images/events/high-camp-trail-pine-forest-beckwourth-peak.jpg"
            alt="Trail winding through pine forest near High Camp with Beckwourth Peak beyond"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- LODGING -->
  <section class="py-20 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-heading text-5xl font-bold uppercase tracking-wide text-charcoal mb-4">Where You'll Stay</h2>
        <p class="font-sans text-charcoal/60 text-lg max-w-xl mx-auto">Two cabins, a yurt, and a campsite — all with access to the shared bathhouse, fire pit, and deck.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        {[
          { title: 'North Cabin', guests: 'Up to 4 guests', detail: '2 queen bunk beds, full kitchen, A/C, private deck, bedding included', href: '/lodging/north-cabin' },
          { title: 'South Cabin', guests: 'Up to 4 guests', detail: '2 queen bunk beds, full kitchen, A/C, private deck, bedding included', href: '/lodging/south-cabin' },
          { title: 'The Yurt', guests: 'Up to 5 guests', detail: '1 queen + 2 full + pullout twin, A/C, kitchen basics, private deck, bedding included', href: '/lodging/yurt' },
          { title: 'Campsite', guests: 'Up to 5 guests', detail: 'Bring your own tent. Picnic table, bathhouse access, fire pit. No linens.', href: '/lodging/campsite' },
        ].map(unit => (
          <div class="bg-white border border-charcoal/10 p-6 flex flex-col">
            <h3 class="font-heading text-xl font-bold uppercase tracking-wide text-charcoal mb-1">{unit.title}</h3>
            <p class="text-cobalt font-sans text-sm font-bold mb-3">{unit.guests}</p>
            <p class="font-sans text-sm text-charcoal/70 leading-relaxed flex-1 mb-4">{unit.detail}</p>
            <a href={unit.href} class="block text-center text-cobalt hover:text-blue-700 font-sans text-xs font-bold mb-3 transition-colors">View unit details →</a>
            <a href={BOOK_URL} target="_blank" rel="noopener" class="block text-center bg-cobalt hover:bg-blue-600 text-white font-heading font-bold uppercase tracking-widest py-3 text-sm transition-colors">
              Check Availability
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-cobalt text-white text-center">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-heading text-4xl md:text-5xl font-bold uppercase tracking-wide mb-4">Make a Weekend of It</h2>
      <p class="font-sans text-white/80 text-lg mb-8">Stay the night before or after the festival and explore the trails, views, and starry skies right from your doorstep. September is one of the best months at High Camp.</p>
      <a href={BOOK_URL} target="_blank" rel="noopener" class="inline-block bg-white text-cobalt hover:bg-cream font-heading font-bold uppercase tracking-widest px-10 py-4 transition-colors text-lg">
        Check Availability
      </a>
    </div>
  </section>

  <Footer />
</Layout>
