---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const REGISTER_URL = 'https://forms.gle/zTQ2vHGermH4LdiW8';
const RWGS_URL = 'https://ridewithgps.com/events/435768-gravel-social-june-2026';
const BOOK_URL = 'https://resnexus.com/resnexus/reservations/book/6C664BF8-3F89-4D87-9E83-DA82447501EB/';

const days = [
  {
    day: 'Day 1',
    label: 'Friday, June 5',
    title: 'Truckee to High Camp',
    miles: '44, 66, or 77 miles',
    desc: 'Drop your bag at the Lift Co-Working parking lot and choose your distance. All routes converge at High Camp, where you\'ll pitch your tent (or check into your cabin or yurt), enjoy an Alibi Ale Works happy hour, a catered dinner from Cuccia\'s in Graeagle, trivia, and a campfire with your fellow riders.',
    food: 'Dinner: Cuccia\'s — pasta, ravioli, Caesar salad. Happy hour sponsored by Alibi Ale Works.',
  },
  {
    day: 'Day 2',
    label: 'Saturday, June 6',
    title: 'Sierra Buttes Loop',
    miles: '50 or 57 miles',
    desc: 'Start with coffee and a grab-and-go breakfast, then ride a scenic loop up to the Sierra Buttes. Top out at Gold Lake (great for a swim) or push on to Mills Peak Lookout for some of the best views in the Lost Sierra. Grab lunch in Graeagle or the Brewing Lair in Blairsden. Back at camp: happy hour, a catered dinner from Sierra Smokeshow, disc golf, trivia, and a campfire.',
    food: 'Dinner: Sierra Smokeshow — BBQ, smoked portobello, potato salad, cornbread. Happy hour sponsored by Alibi Ale Works.',
  },
  {
    day: 'Day 3',
    label: 'Sunday, June 7',
    title: 'High Camp to Truckee',
    miles: '46 or 62 miles',
    desc: 'Pack your bag, grab coffee and breakfast, and choose your return route — different roads than Day 1. Optional lunch stop in Sierraville. After returning to your car, swing by Alibi Ale Works in Truckee to pick up your bag.',
    food: 'Coffee, breakfast, and ride snacks provided.',
  },
];

const faqs = [
  {
    q: 'Is the ride supported?',
    a: 'No — this is an unsupported ride. We provide suggested routes on Ride with GPS, which you navigate with your phone or GPS device. No aid stations, sag vehicles, or traffic controls. Some sections have no cell coverage, so consider riding with a friend or carrying a satellite device like a Garmin InReach.',
  },
  {
    q: 'What kind of bike do I need?',
    a: 'The ideal setup is a gravel bike with 45mm tires or a hardtail mountain bike. Routes are mostly gravel forest roads with some pavement and non-technical singletrack. Plan to carry 2+ liters of water, snacks, extra layers, and tools. E-bikes with adequate range are an option.',
  },
  {
    q: 'What\'s the bag shuttle?',
    a: 'Pack everything you need for two nights — clothes, tent, sleeping bag, towel, toiletries — into one duffel. Meet the shuttle vehicle in Truckee between 8–9am on Friday. If starting from Stampede Reservoir, drop your bag in Truckee first. After Sunday\'s ride, pick up your bag at Alibi Ale Works in Truckee.',
  },
  {
    q: 'How do I book a cabin or yurt?',
    a: 'Text us at 530-322-0322 and let us know which unit you\'d like. We\'ll confirm availability and get you set up. First come, first served. Everyone staying in a cabin or yurt still needs to register and pay for a Gravel Social spot separately.',
  },
  {
    q: 'What\'s the cancellation policy?',
    a: 'Cancel by April 30 and receive a refund minus a 10% fee. After April 30, no refunds — but you can transfer your spot to another rider, who must register and sign the waiver. This applies to cabin and yurt rentals too.',
  },
  {
    q: 'What happens after I register?',
    a: 'After signing the waiver and paying, you\'ll receive all event details by email. You can also join a private Facebook group to connect with other participants and coordinate carpools from Truckee.',
  },
];
---

<Layout
  title="High Camp Gravel Social | June 5–7, 2026 | Lost Sierra"
  description="Three days of gravel riding in the Lost Sierra, based at Beckwourth Peak High Camp. Bag shuttle, catered meals, Alibi beer, hot showers, and campfires. June 5–7, 2026."
  ogImage="/images/events/gravel-social-riders-lost-sierra-forest-road.jpg"
>
  <Nav />

  <!-- HERO -->
  <section class="relative h-[70vh] min-h-[500px] flex items-end overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/images/events/gravel-social-riders-lost-sierra-forest-road.jpg')"
    ></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
    <div class="relative z-10 max-w-8xl mx-auto px-6 pb-12 w-full">
      <p class="text-gold font-heading text-sm font-bold uppercase tracking-widest mb-2">High Camp Hosted Event</p>
      <h1 class="font-heading text-5xl md:text-7xl font-bold uppercase tracking-wide text-white leading-none mb-3">High Camp<br>Gravel Social</h1>
      <p class="text-white/80 font-sans text-xl mb-8">June 5–7, 2026 &bull; Truckee to Portola &bull; Lost Sierra, CA</p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href={REGISTER_URL} target="_blank" rel="noopener" class="inline-block bg-cobalt hover:bg-blue-600 text-white font-heading font-bold uppercase tracking-widest px-8 py-4 transition-colors text-center">
          Register — $335
        </a>
        <a href="#lodging" class="inline-block border-2 border-white text-white hover:bg-white hover:text-charcoal font-heading font-bold uppercase tracking-widest px-8 py-4 transition-colors text-center">
          Book Lodging
        </a>
      </div>
      <p class="mt-4 font-sans text-sm text-white/70"><span class="text-gold font-bold">2 of 40 spots remaining.</span> Register soon to secure your place.</p>
    </div>
  </section>

  <!-- HOW TO REGISTER -->
  <section class="bg-charcoal text-white py-10 border-b border-white/10">
    <div class="max-w-8xl mx-auto px-6">
      <p class="text-gold font-heading text-xs font-bold uppercase tracking-widest text-center mb-6">How to Register</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-2xl mx-auto">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-9 h-9 rounded-full bg-cobalt flex items-center justify-center font-heading font-bold text-white text-lg">1</div>
          <div>
            <p class="font-heading font-bold uppercase tracking-wide text-white mb-1">Complete Registration & Waiver</p>
            <p class="font-sans text-white/60 text-sm leading-relaxed">Fill out the registration form and sign the waiver online. This secures your spot.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-9 h-9 rounded-full bg-cobalt flex items-center justify-center font-heading font-bold text-white text-lg">2</div>
          <div>
            <p class="font-heading font-bold uppercase tracking-wide text-white mb-1">Pay for Your Entry</p>
            <p class="font-sans text-white/60 text-sm leading-relaxed">After submitting the form, you'll be directed to complete payment. Your registration is not confirmed until payment is received.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VIDEO -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-8">
        <p class="text-cobalt font-heading text-sm font-bold uppercase tracking-widest mb-2">See It for Yourself</p>
        <h2 class="font-heading text-4xl font-bold uppercase tracking-wide text-charcoal">What the Ride Is Like</h2>
      </div>
      <div class="relative overflow-hidden shadow-lg" style="padding-top: 56.25%;">
        <iframe
          class="absolute inset-0 w-full h-full"
          src="https://www.youtube.com/embed/u3X-c4E_JOw"
          title="High Camp Gravel Social — Lost Sierra gravel riding"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <!-- WHAT IS IT -->
  <section class="py-20 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-cobalt font-heading text-sm font-bold uppercase tracking-widest mb-3">What Is the High Camp Gravel Social?</p>
          <h2 class="font-heading text-5xl font-bold uppercase tracking-wide text-charcoal mb-6">Three Days of Riding the Lost Sierra</h2>
          <p class="font-sans text-lg text-charcoal/80 leading-relaxed mb-4">
            It's three days of beautiful gravel routes — from Truckee up to Beckwourth Peak, through the Sierra Buttes, and back. You stay at High Camp, an off-grid glamping property on 65 acres with hot showers, modern bathrooms, and views in every direction.
          </p>
          <p class="font-sans text-lg text-charcoal/80 leading-relaxed mb-4">
            The rides are unsupported, but social. And the fun continues into the night. Expect catered dinners, grab-and-go breakfasts, Alibi Ale Works happy hours, campfires, and a disc golf course to keep you busy between rides.
          </p>
          <p class="font-sans text-lg text-charcoal/80 leading-relaxed mb-8">
            Routes are 60% gravel / 40% pavement with some non-technical singletrack. Designed for both seasoned and newer riders who enjoy beautiful scenery and good company over a podium finish.
          </p>
          <a href={RWGS_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-cobalt hover:text-blue-700 font-sans font-bold transition-colors">
            View all routes on Ride with GPS →
          </a>
        </div>
        <div>
          <div class="grid grid-cols-2 gap-1">
            <div class="overflow-hidden h-56">
              <img src="/images/events/gravel-social-riders-lost-sierra-pines.jpg" alt="Gravel riders on a forest road in the Lost Sierra" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="overflow-hidden h-56">
              <img src="/images/events/mills-peak-lookout-lost-sierra-gravel.jpg" alt="Mills Peak Lookout view on the Lost Sierra gravel route" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="overflow-hidden h-56 col-span-2">
              <img src="/images/events/gravel-social-june-2026-route-map.jpg" alt="High Camp Gravel Social 2026 route map showing all three days" class="w-full h-full object-cover object-top" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HIGHLIGHTS BAR -->
  <section class="bg-cobalt text-white py-10">
    <div class="max-w-8xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        {[
          { stat: '3 Days', label: 'of riding' },
          { stat: 'Bag Shuttle', label: 'Truckee ↔ High Camp' },
          { stat: 'Catered Meals', label: 'dinners & breakfasts' },
          { stat: 'Hot Showers', label: '+ campfires nightly' },
        ].map(item => (
          <div>
            <p class="font-heading text-2xl font-bold uppercase tracking-wide mb-1">{item.stat}</p>
            <p class="font-sans text-white/70 text-sm">{item.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ITINERARY -->
  <section class="py-20 bg-white">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-14">
        <h2 class="font-heading text-5xl md:text-6xl font-bold uppercase tracking-wide text-charcoal">The Itinerary</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {days.map((d, i) => (
          <div class="border-t-4 border-cobalt pt-6">
            <p class="text-cobalt font-heading text-xs font-bold uppercase tracking-widest mb-1">{d.day}</p>
            <p class="text-charcoal/50 font-sans text-sm mb-3">{d.label}</p>
            <h3 class="font-heading text-2xl font-bold uppercase tracking-wide text-charcoal mb-2">{d.title}</h3>
            <p class="text-gold font-sans text-sm font-bold mb-4">{d.miles}</p>
            <p class="font-sans text-charcoal/75 text-sm leading-relaxed mb-4">{d.desc}</p>
            <p class="font-sans text-charcoal/55 text-xs leading-relaxed italic">{d.food}</p>
          </div>
        ))}
      </div>
      <div class="mt-12 overflow-hidden rounded shadow-md">
        <img
          src="/images/events/gravel-social-june-2026-route-map.jpg"
          alt="Route map for the High Camp Gravel Social June 2026 showing all three days"
          class="w-full"
        />
      </div>
    </div>
  </section>

  <!-- CAMPFIRE / VIBE -->
  <section class="py-20 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="overflow-hidden">
          <img src="/images/events/high-camp-gravel-social-campfire-dinner.jpg" alt="Riders gathered around the campfire at High Camp during the Gravel Social" class="w-full h-80 object-cover" />
        </div>
        <div>
          <p class="text-cobalt font-heading text-sm font-bold uppercase tracking-widest mb-3">After the Ride</p>
          <h2 class="font-heading text-4xl font-bold uppercase tracking-wide text-charcoal mb-6">The Full Camp Experience</h2>
          <ul class="space-y-3 font-sans text-charcoal/80">
            {[
              'Hot showers in the shared bathhouse',
              'Catered dinners by Cuccia\'s (Friday) and Sierra Smokeshow (Saturday)',
              'Grab-and-go breakfasts and ride snacks daily',
              'Happy hours sponsored by Alibi Ale Works',
              'Campfires every night',
              '20-basket disc golf course',
              'Bag shuttle Truckee ↔ High Camp',
            ].map(item => (
              <li class="flex items-start gap-3">
                <span class="text-cobalt font-bold mt-0.5">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <div class="mt-6 border-t border-charcoal/10 pt-5">
            <p class="font-sans text-charcoal/70 text-sm leading-relaxed">
              <span class="font-bold text-charcoal">Optional add-on:</span> Sports massage available to book separately. Text 530-322-0322 to schedule — slots are limited, first come, first served.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LODGING -->
  <section id="lodging" class="py-20 bg-charcoal text-white">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="text-gold font-heading text-sm font-bold uppercase tracking-widest mb-3">Optional Add-On</p>
        <h2 class="font-heading text-5xl font-bold uppercase tracking-wide mb-4">Upgrade Your Stay</h2>
        <p class="font-sans text-white/70 text-lg max-w-2xl mx-auto">Tent camping for two nights is included with your registration. Upgrade to a cabin or yurt to sleep in a real bed — everyone in the unit still needs to register for the Gravel Social separately.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">

        <!-- Tent Camping -->
        <div class="bg-white/5 border border-white/10 p-7 flex flex-col">
          <h3 class="font-heading text-xl font-bold uppercase tracking-wide text-white mb-1">Tent Camping</h3>
          <p class="text-gold font-heading font-bold text-lg mb-1">Included</p>
          <p class="text-white/50 font-sans text-xs mb-4">Bring your own tent & sleeping bag</p>
          <p class="font-sans text-white/70 text-sm leading-relaxed flex-1 mb-6">Access to the shared bathhouse, fire pit, and all common areas.</p>
          <p class="text-white/30 font-sans text-sm italic">Included with registration</p>
        </div>

        <!-- North Cabin — Sold Out -->
        <div class="bg-white/5 border border-white/10 p-7 flex flex-col relative overflow-hidden opacity-60">
          <div class="absolute top-4 right-4 bg-red-500 text-white font-heading font-bold text-xs uppercase tracking-widest px-3 py-1">Sold Out</div>
          <h3 class="font-heading text-xl font-bold uppercase tracking-wide text-white mb-1">North Cabin</h3>
          <p class="text-gold font-heading font-bold text-lg mb-1">$610.60 / 2 nights</p>
          <p class="text-white/50 font-sans text-xs mb-4">2 queen beds, up to 4 people</p>
          <p class="font-sans text-white/70 text-sm leading-relaxed flex-1 mb-6">Air conditioning, full kitchen, private deck, and bedding included.</p>
          <a href="/lodging/north-cabin" class="text-center text-white/40 font-heading font-bold uppercase tracking-widest text-xs border border-white/20 py-3 hover:text-white hover:border-white/40 transition-colors">View Unit</a>
        </div>

        <!-- South Cabin — Sold Out -->
        <div class="bg-white/5 border border-white/10 p-7 flex flex-col relative overflow-hidden opacity-60">
          <div class="absolute top-4 right-4 bg-red-500 text-white font-heading font-bold text-xs uppercase tracking-widest px-3 py-1">Sold Out</div>
          <h3 class="font-heading text-xl font-bold uppercase tracking-wide text-white mb-1">South Cabin</h3>
          <p class="text-gold font-heading font-bold text-lg mb-1">$610.60 / 2 nights</p>
          <p class="text-white/50 font-sans text-xs mb-4">2 queen beds, up to 4 people</p>
          <p class="font-sans text-white/70 text-sm leading-relaxed flex-1 mb-6">Air conditioning, full kitchen, private deck, and bedding included.</p>
          <a href="/lodging/south-cabin" class="text-center text-white/40 font-heading font-bold uppercase tracking-widest text-xs border border-white/20 py-3 hover:text-white hover:border-white/40 transition-colors">View Unit</a>
        </div>

        <!-- Yurt — Sold Out -->
        <div class="bg-white/5 border border-white/10 p-7 flex flex-col relative overflow-hidden opacity-60">
          <div class="absolute top-4 right-4 bg-red-500 text-white font-heading font-bold text-xs uppercase tracking-widest px-3 py-1">Sold Out</div>
          <h3 class="font-heading text-xl font-bold uppercase tracking-wide text-white mb-1">The Yurt</h3>
          <p class="text-gold font-heading font-bold text-lg mb-1">$677.80 / 2 nights</p>
          <p class="text-white/50 font-sans text-xs mb-4">1 queen, 2 full, pullout twin — up to 5</p>
          <p class="font-sans text-white/70 text-sm leading-relaxed flex-1 mb-6">Private deck, air conditioning, kitchen basics, and bedding included.</p>
          <a href="/lodging/yurt" class="text-center text-white/40 font-heading font-bold uppercase tracking-widest text-xs border border-white/20 py-3 hover:text-white hover:border-white/40 transition-colors">View Unit</a>
        </div>

      </div>
      <p class="text-center text-white/40 font-sans text-xs">Cabins and yurt are first come, first served. A portion of the fridge space in rental units will be used to store catered food.</p>
    </div>
  </section>

  <!-- PHOTO GALLERY -->
  <section class="py-20 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-cobalt font-heading text-sm font-bold uppercase tracking-widest mb-2">Photos from Previous Events</p>
        <h2 class="font-heading text-4xl font-bold uppercase tracking-wide text-charcoal">The 2024 & 2025 Gravel Socials</h2>
      </div>
      <div class="columns-2 md:columns-3 lg:columns-4 gap-3">
        {[
          { src: '/images/events/high-camp-gravel-social-sunset-mountain-view.jpg', alt: 'Sunset view of High Camp deck with string lights and mountain backdrop during the Gravel Social' },
          { src: '/images/events/gravel-social-riders-pine-forest-road.jpg', alt: 'Group of gravel riders on a pine forest road in the Lost Sierra' },
          { src: '/images/events/high-camp-gravel-social-breakfast-deck.jpg', alt: 'Gravel Social riders eating breakfast under the covered deck at High Camp' },
          { src: '/images/events/gravel-social-two-riders-sierra-meadow.jpg', alt: 'Two gravel cyclists riding through the Sierra Valley meadow on a clear day' },
          { src: '/images/events/high-camp-gravel-social-catered-dinner-buffet.jpg', alt: 'Riders serving themselves from the catered dinner buffet at High Camp' },
          { src: '/images/events/gold-lake-sierra-buttes-gravel-route.jpg', alt: 'Gold Lake with Sierra Buttes reflected on the water — a highlight on the Day 2 route' },
          { src: '/images/events/gravel-social-riders-tall-pines-lost-sierra.jpg', alt: 'Gravel riders descending through tall pine trees in the Lost Sierra' },
          { src: '/images/events/gravel-social-lunch-stop-bikes-restaurant.jpg', alt: 'Gravel bikes parked outside a restaurant lunch stop during the Gravel Social' },
          { src: '/images/events/mills-peak-lookout-tower-rocky-ridge.jpg', alt: 'Mills Peak fire lookout tower perched on a rocky ridge above the Lost Sierra' },
          { src: '/images/events/gravel-social-riders-open-valley-road.jpg', alt: 'Gravel cyclists riding an open road through a wide valley with blue skies' },
          { src: '/images/events/high-camp-cabin-adirondack-gravel-bike-dusk.jpg', alt: 'Gravel bike parked beside Adirondack chairs on a cabin deck at dusk with mountain views' },
          { src: '/images/events/high-camp-gravel-social-shuttle-bags-deck.jpg', alt: 'Shuttle bags laid out at High Camp with the shaded deck and mountains in the background' },
          { src: '/images/events/high-camp-cabin-interior-bunk-beds-kitchen.jpg', alt: 'Interior of the High Camp cabin showing bunk beds, full kitchen, and forest views through large windows' },
          { src: '/images/events/high-camp-yurt-exterior-deck-mountains.jpg', alt: 'The High Camp yurt with its private deck and mountain views' },
          { src: '/images/events/high-camp-yurt-interior-queen-bed-loft.jpg', alt: 'Interior of the High Camp yurt with queen bed and ladder to the loft' },
          { src: '/images/events/high-camp-yurt-loft-beds-interior.jpg', alt: 'Yurt loft with two full beds at High Camp' },
        ].map(img => (
          <img
            src={img.src}
            alt={img.alt}
            class="w-full mb-3 break-inside-avoid"
            loading="lazy"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-heading text-5xl font-bold uppercase tracking-wide text-charcoal">Common Questions</h2>
      </div>
      <div class="divide-y divide-charcoal/10">
        {faqs.map(faq => (
          <div class="py-7">
            <h3 class="font-heading text-lg font-bold uppercase tracking-wide text-charcoal mb-3">{faq.q}</h3>
            <p class="font-sans text-charcoal/75 leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SPONSOR -->
  <section class="py-12 bg-cream border-t border-charcoal/10">
    <div class="max-w-8xl mx-auto px-6 text-center">
      <p class="text-charcoal/50 font-sans text-xs uppercase tracking-widest mb-6">Happy Hour Sponsor</p>
      <img src="/images/events/alibi-ale-works-sponsor-logo.png" alt="Alibi Ale Works — Happy Hour Sponsor of the High Camp Gravel Social" class="h-20 w-auto mx-auto opacity-80" />
    </div>
  </section>

  <!-- REGISTER CTA -->
  <section class="py-20 bg-cobalt text-white text-center">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-heading text-4xl md:text-5xl font-bold uppercase tracking-wide mb-4">Ready to Ride?</h2>
      <p class="font-sans text-white/80 text-lg mb-8">$335 + $10 transaction fee per rider. Includes 2-night tent permit, bag shuttle, all meals and happy hours listed above, bathhouse access, and campfires.</p>
      <a href={REGISTER_URL} target="_blank" rel="noopener" class="inline-block bg-white text-cobalt hover:bg-cream font-heading font-bold uppercase tracking-widest px-10 py-4 transition-colors text-lg">
        Register Now
      </a>
    </div>
  </section>

  <Footer />
</Layout>
