---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const BOOK_URL = 'https://resnexus.com/resnexus/reservations/book/6C664BF8-3F89-4D87-9E83-DA82447501EB/';

const photos = [
  { src: `/images/routes/mountain-bikers-mt-hough-summit.jpg`, alt: 'Group of mountain bikers at the Mt. Hough Trail summit sign' },
  { src: `/images/routes/beckwourth-peak-trail-arch-feature.jpg`, alt: 'Mountain biker on the Beckwourth Peak Trail arch feature, Lost Sierra' },
  { src: `/images/instagram/glamping-off-grid-lost-sierra.jpg`, alt: 'Mountain biking near Beckwourth Peak High Camp in the Lost Sierra' },
];

const trails = [
  {
    name: 'Beckwourth Peak Trail',
    tag: 'At High Camp',
    difficulty: 'Intermediate',
    distance: '14–16+ mi',
    elevation: '1,540–2,300 ft',
    surface: 'Singletrack',
    desc: 'An intermediate cross-country trail that rides around the mountain with sweeping views of the Lost Sierra. Singletrack leaves directly from High Camp; no car needed.',
    videoId: 'G1ChlpLBVDc',
    mapLabel: 'View on Ride with GPS',
    mapUrl: 'https://ridewithgps.com/routes/52460523',
  },
  {
    name: 'Mills Peak Trail',
    tag: '23 min from High Camp',
    difficulty: 'Intermediate',
    distance: '7.3 mi',
    elevation: '2,608 ft descent',
    surface: 'Singletrack',
    desc: 'A fast and fun high-mountain singletrack that rips down between close trees and large embedded rocks. A shuttle to the top is strongly recommended.',
    videoId: 'JosCvYcS5HQ',
    mapLabel: 'View on Trailforks',
    mapUrl: 'https://www.trailforks.com/trails/mills-peak-trail/',
  },
  {
    name: 'Mount Hough Trail System',
    tag: '54 min from High Camp',
    difficulty: 'All Levels',
    distance: '67 trails',
    elevation: 'Up to 2,142 ft descent',
    surface: 'Singletrack',
    desc: '50+ miles of SBTS-built singletrack, with 3,800 vertical feet of flowy, fast descent.',
    videoId: '2CJNH2ZFc3g',
    mapLabel: 'View on Trailforks',
    mapUrl: 'https://www.trailforks.com/region/mt-hough-18055/',
  },
];
---

<Layout
  title="Mountain Biking Routes | Beckwourth Peak High Camp"
  description="Mountain biking trails near Beckwourth Peak High Camp in the Lost Sierra. Ride singletrack from the property and access Mills Peak and Mount Hough nearby."
>
  <Nav />

  <!-- HERO -->
  <section class="relative h-[55vh] min-h-[380px] flex items-end overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style={`background-image: url('/images/nearby/mt-hough-singletrack-trails.jpg')`}
    ></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
    <div class="relative z-10 max-w-8xl mx-auto px-6 pb-10 w-full">
      <p class="text-gold font-heading text-sm font-bold uppercase tracking-widest mb-2">Trails at High Camp</p>
      <h1 class="font-heading text-5xl md:text-7xl font-bold uppercase tracking-wide text-white">Mountain Biking Routes</h1>
      <p class="text-white/80 font-sans text-lg mt-2">Lost Sierra &bull; Portola, CA</p>
    </div>
  </section>

  <!-- PHOTO STRIP -->
  <section class="bg-charcoal py-2 px-2">
    <div class="grid grid-cols-3 gap-2 max-w-8xl mx-auto">
      {photos.map((photo) => (
        <div class="overflow-hidden h-52">
          <img
            src={photo.src}
            alt={photo.alt}
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
          />
        </div>
      ))}
    </div>
  </section>

  <!-- MTB WEEKEND CALLOUT -->
  <section class="bg-cobalt pt-5 pb-6 px-6 text-center">
    <p class="text-white font-sans text-lg font-bold mb-4">Want a great mountain biking weekend itinerary?</p>
    <a
      href="/mountain-biking-weekend"
      class="inline-block bg-white text-cobalt hover:bg-cream font-bold px-8 py-3 rounded text-base transition-colors uppercase tracking-wide font-heading"
    >
      Ultimate Mountain Biking Weekend
    </a>
  </section>

  <!-- CONTENT -->
  <section class="py-20 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">

        <!-- Left: trail sections -->
        <div class="lg:col-span-2 space-y-20">

          {trails.map((trail) => (
            <div>
              <!-- Header -->
              <div class="flex items-center gap-3 mb-2">
                <span class="font-sans text-xs font-bold uppercase tracking-widest text-cobalt">{trail.tag}</span>
                <span class="text-charcoal/30">|</span>
                <span class="font-sans text-xs text-charcoal/50 font-bold uppercase tracking-wider">{trail.difficulty}</span>
              </div>
              <h2 class="font-heading text-4xl font-bold uppercase tracking-wide text-charcoal mb-4">{trail.name}</h2>
              <p class="font-sans text-base text-charcoal/70 leading-relaxed mb-6">{trail.desc}</p>

              <!-- Trail map link -->
              <a
                href={trail.mapUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 text-cobalt hover:text-blue-600 font-sans text-sm font-bold transition-colors mb-8"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                {trail.mapLabel}
              </a>

              <!-- Stats -->
              <div class="flex flex-wrap gap-6 mb-8">
                <div class="bg-white border border-charcoal/10 px-5 py-3 rounded shadow-sm">
                  <p class="font-heading text-xs font-bold uppercase tracking-widest text-charcoal/40 mb-1">Distance</p>
                  <p class="font-sans text-sm font-bold text-charcoal">{trail.distance}</p>
                </div>
                <div class="bg-white border border-charcoal/10 px-5 py-3 rounded shadow-sm">
                  <p class="font-heading text-xs font-bold uppercase tracking-widest text-charcoal/40 mb-1">Elevation</p>
                  <p class="font-sans text-sm font-bold text-charcoal">{trail.elevation}</p>
                </div>
                <div class="bg-white border border-charcoal/10 px-5 py-3 rounded shadow-sm">
                  <p class="font-heading text-xs font-bold uppercase tracking-widest text-charcoal/40 mb-1">Surface</p>
                  <p class="font-sans text-sm font-bold text-charcoal">{trail.surface}</p>
                </div>
              </div>

              <!-- Video -->
              <div>
                <p class="font-heading text-xs font-bold uppercase tracking-widest text-charcoal/40 mb-3">Trail Preview</p>
                <div class="relative w-full rounded shadow-md overflow-hidden" style="padding-top: 56.25%">
                  <iframe
                    src={`https://www.youtube.com/embed/${trail.videoId}`}
                    title={`${trail.name} trail video`}
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    class="absolute inset-0 w-full h-full"
                  ></iframe>
                </div>
              </div>
            </div>
          ))}

        </div>

        <!-- Right: sidebar -->
        <div>
          <div class="bg-white shadow-md p-8 sticky top-24 space-y-8">

            <div>
              <p class="font-heading text-sm font-bold uppercase tracking-widest text-charcoal/40 mb-4">Trail Maps</p>
              <div class="space-y-3">
                <a
                  href="https://ridewithgps.com/routes/52460523"
                  target="_blank"
                  rel="noopener"
                  class="block text-center bg-charcoal hover:bg-black text-white font-bold px-5 py-3 rounded text-sm transition-colors uppercase tracking-wide font-heading w-full"
                >
                  Beckwourth Peak on RWGPS
                </a>
                <a
                  href="https://www.trailforks.com/trails/mills-peak-trail/"
                  target="_blank"
                  rel="noopener"
                  class="block text-center bg-charcoal hover:bg-black text-white font-bold px-5 py-3 rounded text-sm transition-colors uppercase tracking-wide font-heading w-full"
                >
                  Mills Peak on Trailforks
                </a>
                <a
                  href="https://www.trailforks.com/region/mt-hough-18055/"
                  target="_blank"
                  rel="noopener"
                  class="block text-center bg-charcoal hover:bg-black text-white font-bold px-5 py-3 rounded text-sm transition-colors uppercase tracking-wide font-heading w-full"
                >
                  Mt. Hough on Trailforks
                </a>
              </div>
            </div>

            <div>
              <p class="font-heading text-sm font-bold uppercase tracking-widest text-charcoal/40 mb-4">Shuttle Service</p>
              <p class="font-sans text-sm text-charcoal/70 leading-relaxed mb-2">
                Yuba Expeditions in Quincy offers shuttle service for Mount Hough.
              </p>
              <a
                href="https://www.yubaexpeditions.com/shuttles"
                target="_blank"
                rel="noopener"
                class="text-cobalt hover:text-blue-600 font-sans text-sm font-bold transition-colors"
              >
                yubaexpeditions.com/shuttles
              </a>
            </div>

            <div>
              <p class="font-heading text-sm font-bold uppercase tracking-widest text-charcoal/40 mb-3">Questions?</p>
              <p class="font-sans text-sm text-charcoal/70 leading-relaxed mb-2">
                Reach out with any questions about mountain biking near High Camp.
              </p>
              <a href="mailto:contact@beckwourthpeakhighcamp.com" class="text-cobalt hover:text-blue-600 font-sans text-sm font-bold transition-colors">
                contact@beckwourthpeakhighcamp.com
              </a>
            </div>

            <div>
              <p class="font-sans text-sm text-charcoal/70 leading-relaxed mb-3">Want a great mountain biking weekend itinerary?</p>
              <a
                href="/mountain-biking-weekend"
                class="block text-center bg-charcoal hover:bg-black text-white font-bold px-5 py-3 rounded text-sm transition-colors uppercase tracking-wide font-heading w-full"
              >
                Ultimate Mountain Biking Weekend
              </a>
            </div>

            <a
              href={BOOK_URL}
              target="_blank"
              rel="noopener"
              class="block text-center bg-cobalt hover:bg-blue-600 text-white font-bold px-6 py-4 rounded text-sm transition-colors uppercase tracking-wide font-heading w-full"
            >
              Book Your Stay
            </a>

          </div>
        </div>

      </div>
    </div>
  </section>

  <Footer />
</Layout>
