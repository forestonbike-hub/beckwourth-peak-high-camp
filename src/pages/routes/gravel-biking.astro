---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const BOOK_URL = 'https://resnexus.com/resnexus/reservations/book/6C664BF8-3F89-4D87-9E83-DA82447501EB/';
const WP = 'https://beckwourthpeakhighcamp.com/wp-content/uploads';

const photos = [
  { src: `${WP}/2024/03/IMG_0925-EDIT.jpg`, alt: 'Gravel riders on an open road through Sierra Valley near Beckwourth Peak High Camp' },
  { src: `${WP}/2025/03/474210364_122206422182086559_3899931610294297086_n-3.jpg`, alt: 'Bikepackers riding a quiet gravel road with mountains in the distance' },
  { src: `${WP}/2024/07/20240602_111125-1.jpg`, alt: 'Riders stopped at a cafe in Loyalton, CA on a gravel route' },
];

const routes = [
  {
    name: 'Lake Davis Loop',
    distance: '53.6 mi',
    elevation: '4,234 ft',
    surface: 'Mixed Gravel & Pavement',
    desc: 'A big day out from High Camp. This loop winds through the quiet forest roads of the Lost Sierra to Lake Davis and back, mixing gravel with stretches of light-traffic highway. At 53 miles and 4,200 feet of climbing, it\'s a proper effort -- save something for the return.',
    mapUrl: 'https://ridewithgps.com/routes/47836067',
  },
  {
    name: 'Lake Davis & Smith Peak',
    distance: '50.3 mi',
    elevation: '5,133 ft',
    surface: 'Mixed Gravel & Pavement',
    desc: 'A harder variation on the Lake Davis loop that adds the climb to Smith Peak. Slightly shorter in distance but with an extra 900 feet of gain -- this is the route when you want to make the day count.',
    mapUrl: 'https://ridewithgps.com/routes/47836112',
  },
  {
    name: 'Smith Peak–Sloat–Graeagle Loop',
    distance: '65.6 mi',
    elevation: '6,737 ft',
    surface: 'Mixed Gravel & Pavement',
    desc: 'The biggest loop in the collection. This route takes in Smith Peak, the mill town of Sloat, and Graeagle in a long day through some of the most scenic terrain in the Lost Sierra. Over 6,700 feet of climbing -- plan accordingly.',
    mapUrl: 'https://ridewithgps.com/routes/48019297',
  },
  {
    name: 'Gold Lake & Mills Peak Loop',
    distance: '55.6 mi',
    elevation: '5,540 ft',
    surface: 'Mixed Gravel & Pavement',
    desc: 'A loop that combines the climb to Mills Peak with a run past Gold Lake in the Lakes Basin. Big views, varied terrain, and a satisfying amount of climbing make this one of the standout routes from High Camp.',
    mapUrl: 'https://ridewithgps.com/routes/53422053',
  },
];
---

<Layout
  title="Gravel Biking Routes | Beckwourth Peak High Camp"
  description="Gravel biking routes from Beckwourth Peak High Camp in the Lost Sierra. Day rides through quiet forest roads and open ranch land near Portola, CA."
>
  <Nav />

  <!-- HERO -->
  <section class="relative h-[55vh] min-h-[380px] flex items-end overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style={`background-image: url('${WP}/2024/03/IMG_0925-EDIT.jpg')`}
    ></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
    <div class="relative z-10 max-w-8xl mx-auto px-6 pb-10 w-full">
      <p class="text-gold font-heading text-sm font-bold uppercase tracking-widest mb-2">Routes at High Camp</p>
      <h1 class="font-heading text-5xl md:text-7xl font-bold uppercase tracking-wide text-white">Gravel Biking Routes</h1>
      <p class="text-white/80 font-sans text-lg mt-2">Lost Sierra &bull; Portola, CA</p>
    </div>
  </section>

  <!-- PHOTO STRIP -->
  <section class="bg-charcoal py-2 px-2">
    <div class="grid grid-cols-3 gap-2 max-w-8xl mx-auto">
      {photos.map((photo) => (
        <div class="overflow-hidden h-52">
          <img
            src={photo.src}
            alt={photo.alt}
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
          />
        </div>
      ))}
    </div>
  </section>

  <!-- CONTENT -->
  <section class="py-20 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">

        <!-- Left: intro + routes -->
        <div class="lg:col-span-2 space-y-16">

          <!-- Intro -->
          <div>
            <h2 class="font-heading text-4xl font-bold uppercase tracking-wide text-charcoal mb-6">Gravel at High Camp</h2>
            <p class="text-charcoal/80 font-sans text-lg leading-relaxed mb-4">
              High Camp sits at the intersection of some of the best gravel roads in the Lost Sierra. Quiet forest roads, open ranch land, and very little traffic make this one of the most underrated gravel destinations in Northern California.
            </p>
            <p class="text-charcoal/80 font-sans text-lg leading-relaxed">
              High Camp is also a base camp for the Lost and Found Gravel Festival, with sections of the race route passing through the property and the surrounding roads.
            </p>
          </div>

          <!-- Route Map -->
          <div>
            <p class="font-heading text-xs font-bold uppercase tracking-widest text-charcoal/40 mb-3">All Routes</p>
            <div class="rounded overflow-hidden shadow-md">
              <iframe
                src="https://ridewithgps.com/embeds?type=event&id=328088"
                style="width: 100%; height: 500px; border: none;"
                scrolling="no"
              ></iframe>
            </div>
          </div>

          <!-- Routes -->
          <div>
            <h2 class="font-heading text-4xl font-bold uppercase tracking-wide text-charcoal mb-10">The Routes</h2>
            <div class="space-y-8">
              {routes.map((route) => (
                <div class="bg-white border border-charcoal/10 rounded shadow-sm p-8">
                  <h3 class="font-heading text-2xl font-bold uppercase tracking-wide text-charcoal mb-5">{route.name}</h3>

                  <div class="flex flex-wrap gap-6 mb-6">
                    <div>
                      <p class="font-heading text-xs font-bold uppercase tracking-widest text-charcoal/40 mb-1">Distance</p>
                      <p class="font-sans text-sm font-bold text-charcoal">{route.distance}</p>
                    </div>
                    <div>
                      <p class="font-heading text-xs font-bold uppercase tracking-widest text-charcoal/40 mb-1">Elevation</p>
                      <p class="font-sans text-sm font-bold text-charcoal">{route.elevation}</p>
                    </div>
                    <div>
                      <p class="font-heading text-xs font-bold uppercase tracking-widest text-charcoal/40 mb-1">Surface</p>
                      <p class="font-sans text-sm font-bold text-cobalt">{route.surface}</p>
                    </div>
                  </div>

                  <p class="font-sans text-base text-charcoal/70 leading-relaxed mb-6">{route.desc}</p>

                  <a
                    href={route.mapUrl}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-2 text-cobalt hover:text-blue-600 font-sans text-sm font-bold transition-colors"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                    </svg>
                    View on Ride with GPS
                  </a>
                </div>
              ))}
            </div>
          </div>

        </div>

        <!-- Right: sidebar -->
        <div>
          <div class="bg-white shadow-md p-8 sticky top-24 space-y-8">

            <div>
              <p class="font-heading text-sm font-bold uppercase tracking-widest text-charcoal/40 mb-4">Route Maps</p>
              <div class="space-y-3">
                <a
                  href="https://ridewithgps.com/routes/47836067"
                  target="_blank"
                  rel="noopener"
                  class="block text-center bg-charcoal hover:bg-black text-white font-bold px-5 py-3 rounded text-sm transition-colors uppercase tracking-wide font-heading w-full"
                >
                  Lake Davis Loop
                </a>
                <a
                  href="https://ridewithgps.com/routes/47836112"
                  target="_blank"
                  rel="noopener"
                  class="block text-center bg-charcoal hover:bg-black text-white font-bold px-5 py-3 rounded text-sm transition-colors uppercase tracking-wide font-heading w-full"
                >
                  Lake Davis & Smith Peak
                </a>
                <a
                  href="https://ridewithgps.com/routes/48019297"
                  target="_blank"
                  rel="noopener"
                  class="block text-center bg-charcoal hover:bg-black text-white font-bold px-5 py-3 rounded text-sm transition-colors uppercase tracking-wide font-heading w-full"
                >
                  Smith Peak–Sloat–Graeagle
                </a>
                <a
                  href="https://ridewithgps.com/routes/53422053"
                  target="_blank"
                  rel="noopener"
                  class="block text-center bg-charcoal hover:bg-black text-white font-bold px-5 py-3 rounded text-sm transition-colors uppercase tracking-wide font-heading w-full"
                >
                  Gold Lake & Mills Peak
                </a>
              </div>
            </div>

            <div>
              <p class="font-heading text-sm font-bold uppercase tracking-widest text-charcoal/40 mb-4">Recommended Bike</p>
              <ul class="space-y-2.5">
                <li class="flex items-start gap-2.5 font-sans text-sm text-charcoal/70">
                  <span class="w-1.5 h-1.5 rounded-full bg-cobalt flex-shrink-0 mt-1.5"></span>
                  Gravel bike with 40mm+ tires
                </li>
                <li class="flex items-start gap-2.5 font-sans text-sm text-charcoal/70">
                  <span class="w-1.5 h-1.5 rounded-full bg-cobalt flex-shrink-0 mt-1.5"></span>
                  Hardtail mountain bike
                </li>
              </ul>
            </div>

            <div>
              <p class="font-heading text-sm font-bold uppercase tracking-widest text-charcoal/40 mb-3">Questions?</p>
              <p class="font-sans text-sm text-charcoal/70 leading-relaxed mb-2">
                Reach out with any questions about gravel riding near High Camp.
              </p>
              <a href="mailto:contact@beckwourthpeakhighcamp.com" class="text-cobalt hover:text-blue-600 font-sans text-sm font-bold transition-colors">
                contact@beckwourthpeakhighcamp.com
              </a>
            </div>

            <a
              href={BOOK_URL}
              target="_blank"
              rel="noopener"
              class="block text-center bg-cobalt hover:bg-blue-600 text-white font-bold px-6 py-4 rounded text-sm transition-colors uppercase tracking-wide font-heading w-full"
            >
              Book Your Stay
            </a>

          </div>
        </div>

      </div>
    </div>
  </section>

  <Footer />
</Layout>
