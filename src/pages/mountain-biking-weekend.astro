---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const BOOK_URL = 'https://resnexus.com/resnexus/reservations/book/6C664BF8-3F89-4D87-9E83-DA82447501EB/';

const reasons = [
  {
    title: 'Trail Proximity',
    desc: 'Direct access to the Beckwourth Peak Trail. Mills Peak and Mt. Hough are nearby.',
  },
  {
    title: 'Real Comfort',
    desc: 'Hot showers, real beds, fire pit evenings, and strong morning coffee.',
  },
  {
    title: 'Great for Groups',
    desc: "Guy's, girl's, or multi-family weekend — book all three units.",
  },
];

const trails = [
  {
    name: 'Beckwourth Peak Trail',
    tag: 'At High Camp',
    distance: '10–16+ mi',
    elevation: '1,500 ft gain',
    notes: 'Rideable directly from the cabin or yurt',
    desc: 'A flowy cross-country trail that winds around the mountain with sweeping views of the Lost Sierra. Singletrack leaves directly from the property — no car, no shuttle, no hassle.',
    img: '/images/routes/beckwourth-peak-trail-mtb-arch.jpg',
    alt: 'Mountain biker riding the arch feature on the Beckwourth Peak Trail, Lost Sierra',
    mapLabel: 'View on Ride with GPS',
    mapUrl: 'https://ridewithgps.com/routes/52460523',
  },
  {
    name: 'Mount Hough Trail System',
    tag: '54 min from High Camp',
    tagUrl: 'https://www.google.com/maps/dir/QGWX%2B9J+Beckwourth+Peak+High+Camp,+518+23N03,+Portola,+CA+96122,+USA/Yuba+Expeditions+Adventure+Center,+550+Crescent+St,+Quincy,+CA+95971/@39.8562468,-121.0323666,148874m/data=!3m2!1e3!4b1!4m14!4m13!1m5!1m1!1s0x809c139aa981c273:0x4c1aaa7c0d9ea4f6!2m2!1d-120.4509375!2d39.7959375!1m5!1m1!1s0x809cf9aaea710d47:0xa5d168c4d6b3f500!2m2!1d-120.9536622!2d39.9438868!3e0!5m1!1e1?entry=ttu&g_ep=EgoyMDI2MDUwMi4wIKXMDSoASAFQAw%3D%3D',
    distance: '50+ miles of trail',
    elevation: 'Up to 4,000 ft descent',
    notes: 'All levels. Kids 11+ welcome. Shuttle strongly recommended.',
    desc: '50+ miles of SBTS-built singletrack with 3,800 vertical feet of fast, flowy descent. Multiple trail options for intermediate riders and children 11+. Shuttle strongly recommended.',
    img: '/images/routes/mt-hough-shuttle-riders.jpg',
    alt: 'Mountain bikers on the Mt. Hough shuttle trail, Lost Sierra',
    mapLabel: 'View on Trailforks',
    mapUrl: 'https://www.trailforks.com/region/mt-hough-18055/',
  },
  {
    name: 'Mills Peak Trail',
    tag: '23 min from High Camp',
    tagUrl: 'https://www.google.com/maps/dir/Beckwourth+Peak+High+Camp,+23N03,+Portola,+CA/39.753661,-120.5988453/@39.7715822,-120.5773352,13145m/am=t/data=!3m2!1e3!4b1!4m10!4m9!1m5!1m1!1s0x809c139aa981c273:0x4c1aaa7c0d9ea4f6!2m2!1d-120.4509375!2d39.7959375!1m1!4e1!3e0?entry=tts&g_ep=EgoyMDI1MDkwMy4wIPu8ASoASAFQAw%3D%3D&skid=c6501399-2e37-47f3-89dd-8ac88adb1397',
    distance: '7.3 mi',
    elevation: '2,600 ft descent',
    notes: 'Intermediate. Shuttle recommended.',
    desc: 'A fast, high-mountain singletrack that rips down between close trees and large embedded rocks. Several trail options, good for kids 11+ and intermediate riders. X-country trail, but some sections are rocky; good for intermediate riders.',
    img: '/images/routes/mills-peak-lookout-trail.jpg',
    alt: 'Mills Peak fire lookout trail in the Lost Sierra near Portola, CA',
    mapLabel: 'View on Trailforks',
    mapUrl: 'https://www.trailforks.com/trails/mills-peak-trail/',
  },
];

const itinerary = [
  {
    day: 'Friday',
    title: 'Arrive & Ride',
    desc: 'Check in at 3pm, get settled, and take an evening spin on the Beckwourth Peak Trail. Grill or head into town for dinner at the Taproom and end the night around the fire pit.',
  },
  {
    day: 'Saturday',
    title: 'Mt. Hough Day',
    desc: 'Reserve a morning shuttle (Yuba Expeditions). Grab breakfast in town, then drive to Quincy and get shuttled to the top. Descending 4,000 feet of singletrack! Then stop at The Brewing Lair on the way back for dinner, beers, and live music.',
  },
  {
    day: 'Sunday',
    title: 'Mills Peak',
    desc: 'Have a lazy breakfast on your private deck. Check out by 11am and drive to the bottom of Mills Peak Trail. Ride to the top or self-shuttle with another car. Descend 2,600 feet! Drive home after an epic MTB weekend!',
  },
];

const shuttles = [
  {
    name: 'Yuba Expeditions',
    desc: 'Bike shuttle service for Mt. Hough, based in Quincy. Van shuttles run Friday through Monday and can take up to 9 riders.',
    url: 'https://www.yubaexpeditions.com/shuttles',
    label: 'yubaexpeditions.com/shuttles',
  },
];

const testimonials = [
  {
    name: 'Adam',
    text: "Beckwourth High Camp is a fantastic spot from which to launch a hiking or biking adventure. Quiet and peaceful with spectacular views in every direction. Yurts and cabins are clean, comfortable and have every amenity, and camp hosts Forest and Bob make it immediately clear that you are among friends there. I look forward to a return visit.",
    unit: 'Cabin Guest',
  },
  {
    name: 'Lorri',
    text: "Very cool and cute little spot. The cabins are stellar, equipped with everything you need. Beautiful views overlooking the mountains. The bathrooms and showers were spotless and well stocked. Fire pit was magical. We had a lovely stay and I would recommend if you are a mountain biker.",
    unit: 'Cabin Guest',
  },
];

const lodging = [
  { name: 'North Cabin', sleeps: 4, beds: '2 queen bunks', link: '/lodging/north-cabin', img: '/images/lodging/north-cabin-exterior-plumas-forest.jpg', alt: 'North Cabin exterior at Beckwourth Peak High Camp' },
  { name: 'South Cabin', sleeps: 4, beds: '2 queen bunks', link: '/lodging/south-cabin', img: '/images/lodging/south-cabin-exterior-sunrise.jpg', alt: 'South Cabin exterior at Beckwourth Peak High Camp' },
  { name: 'The Yurt', sleeps: 5, beds: '4 beds + loft', link: '/lodging/yurt', img: '/images/lodging/yurt-private-deck-mountains.jpg', alt: 'The Yurt at Beckwourth Peak High Camp with mountain views' },
  { name: 'Campsite', sleeps: 5, beds: 'Bring your tent', link: '/lodging/campsite', img: '/images/lodging/campsite-tent-platform-lost-sierra.jpg', alt: 'Campsite at Beckwourth Peak High Camp, Lost Sierra' },
];
---

<Layout
  title="Mountain Biking Weekend in NorCal | Beckwourth Peak High Camp"
  description="Plan your NorCal mountain biking weekend at High Camp in the Lost Sierra. Ride Beckwourth Peak, Mills Peak, and Mt. Hough from a comfortable off-grid glamping basecamp near Portola, CA."
>
  <Nav />

  <!-- HERO -->
  <section class="relative h-[65vh] min-h-[480px] flex items-end overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/images/routes/mountain-biking-group-lost-sierra.jpg')"
    ></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/30 to-transparent"></div>
    <div class="relative z-10 max-w-8xl mx-auto px-6 pb-12 w-full">
      <p class="text-gold font-heading text-sm font-bold uppercase tracking-widest mb-3">Lost Sierra, Portola CA</p>
      <h1 class="font-heading text-5xl md:text-7xl font-bold uppercase tracking-wide text-white leading-none mb-4">Mt. Hough &amp; Mills Peak<br />MTB Weekend</h1>
      <p class="text-white/80 font-sans text-lg max-w-2xl">A perfect 3-day itinerary for the ultimate mountain biking weekend.</p>
    </div>
  </section>

  <!-- WEEKEND ITINERARY -->
  <section class="pt-12 pb-20 bg-charcoal text-white">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-heading text-4xl md:text-5xl font-bold uppercase tracking-wide mb-5">Suggested Itinerary</h2>
        <p class="text-white/60 font-sans text-lg max-w-2xl mx-auto">Access to 3 amazing MTB trails: Mt. Hough, Mills Peak, and the Beckwourth Peak Trail. Ride and then relax: comfy beds, hot showers, disc golf, and a campfire under starry skies. <a href="#lodging" class="text-cobalt hover:text-blue-400 font-bold transition-colors underline underline-offset-4">View lodging options</a></p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {itinerary.map((day) => (
          <div class="border border-white/10 p-8">
            <p class="text-cobalt font-heading text-sm font-bold uppercase tracking-widest mb-2">{day.day}</p>
            <h3 class="font-heading text-2xl font-bold uppercase tracking-wide mb-4">{day.title}</h3>
            <p class="text-white/70 font-sans text-sm leading-relaxed">{day.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TRAILS -->
  <section class="py-20 bg-white">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-heading text-5xl md:text-6xl font-bold uppercase tracking-wide text-charcoal mb-4">The Trails</h2>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center mb-12">
        <img
          src="/images/routes/mtb-trails-map-high-camp.jpg"
          alt="Map showing Beckwourth Peak Trail, Mills Peak, and Mt. Hough in relation to High Camp, Lost Sierra"
          class="w-full shadow-md"
        />
        <div class="space-y-8">
          <div>
            <p class="text-cobalt font-heading text-xs font-bold uppercase tracking-widest mb-1">At High Camp</p>
            <h3 class="font-heading text-2xl font-bold uppercase tracking-wide text-charcoal mb-1">Beckwourth Peak Trail</h3>
            <p class="font-sans text-sm text-charcoal/60">10–16+ mi &bull; 1,500 ft gain &bull; Non-technical, singletrack from the property</p>
          </div>
          <div>
            <a href="https://www.google.com/maps/dir/QGWX%2B9J+Beckwourth+Peak+High+Camp,+518+23N03,+Portola,+CA+96122,+USA/Yuba+Expeditions+Adventure+Center,+550+Crescent+St,+Quincy,+CA+95971/@39.8562468,-121.0323666,148874m/data=!3m2!1e3!4b1!4m14!4m13!1m5!1m1!1s0x809c139aa981c273:0x4c1aaa7c0d9ea4f6!2m2!1d-120.4509375!2d39.7959375!1m5!1m1!1s0x809cf9aaea710d47:0xa5d168c4d6b3f500!2m2!1d-120.9536622!2d39.9438868!3e0!5m1!1e1?entry=ttu&g_ep=EgoyMDI2MDUwMi4wIKXMDSoASAFQAw%3D%3D" target="_blank" rel="noopener" class="text-cobalt hover:text-blue-600 transition-colors font-heading text-xs font-bold uppercase tracking-widest mb-1 block">54 min from High Camp</a>
            <h3 class="font-heading text-2xl font-bold uppercase tracking-wide text-charcoal mb-1">Mount Hough Trail System</h3>
            <p class="font-sans text-sm text-charcoal/60">50+ miles &bull; Up to 4,000 ft descent &bull; All levels &bull; Shuttle strongly recommended</p>
          </div>
          <div>
            <a href="https://www.google.com/maps/dir/Beckwourth+Peak+High+Camp,+23N03,+Portola,+CA/39.753661,-120.5988453/@39.7715822,-120.5773352,13145m/am=t/data=!3m2!1e3!4b1!4m10!4m9!1m5!1m1!1s0x809c139aa981c273:0x4c1aaa7c0d9ea4f6!2m2!1d-120.4509375!2d39.7959375!1m1!4e1!3e0?entry=tts&g_ep=EgoyMDI1MDkwMy4wIPu8ASoASAFQAw%3D%3D&skid=c6501399-2e37-47f3-89dd-8ac88adb1397" target="_blank" rel="noopener" class="text-cobalt hover:text-blue-600 transition-colors font-heading text-xs font-bold uppercase tracking-widest mb-1 block">23 min from High Camp</a>
            <h3 class="font-heading text-2xl font-bold uppercase tracking-wide text-charcoal mb-1">Mills Peak Trail</h3>
            <p class="font-sans text-sm text-charcoal/60">7.3 mi &bull; 2,600 ft descent &bull; Shuttle recommended</p>
          </div>
        </div>
      </div>
      <div class="space-y-8">
        {trails.map((trail) => (
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 shadow-md overflow-hidden">
            <div class="relative h-64 lg:h-auto overflow-hidden">
              <img
                src={trail.img}
                alt={trail.alt}
                class="w-full h-full object-cover"
              />
            </div>
            <div class="bg-cream p-8 flex flex-col justify-center">
              {trail.tagUrl ? (
                <a href={trail.tagUrl} target="_blank" rel="noopener" class="text-cobalt hover:text-blue-600 transition-colors font-heading text-xs font-bold uppercase tracking-widest mb-2 block">{trail.tag}</a>
              ) : (
                <p class="text-cobalt font-heading text-xs font-bold uppercase tracking-widest mb-2">{trail.tag}</p>
              )}
              <h3 class="font-heading text-3xl font-bold uppercase tracking-wide text-charcoal mb-3">{trail.name}</h3>
              <p class="text-charcoal/70 font-sans text-base leading-relaxed mb-5">{trail.desc}</p>
              <div class="flex flex-wrap gap-4 mb-5">
                <div>
                  <p class="font-heading text-xs font-bold uppercase tracking-widest text-charcoal/40 mb-1">Distance</p>
                  <p class="font-sans text-sm font-bold text-charcoal">{trail.distance}</p>
                </div>
                <div>
                  <p class="font-heading text-xs font-bold uppercase tracking-widest text-charcoal/40 mb-1">Elevation</p>
                  <p class="font-sans text-sm font-bold text-charcoal">{trail.elevation}</p>
                </div>
                <div>
                  <p class="font-heading text-xs font-bold uppercase tracking-widest text-charcoal/40 mb-1">Notes</p>
                  <p class="font-sans text-sm font-bold text-charcoal">{trail.notes}</p>
                </div>
              </div>
              <a
                href={trail.mapUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 text-cobalt hover:text-blue-600 font-sans text-sm font-bold transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                {trail.mapLabel}
              </a>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <a
          href="/routes/mountain-biking"
          class="inline-block border-2 border-cobalt text-cobalt hover:bg-cobalt hover:text-white font-bold px-8 py-3 rounded text-sm transition-colors uppercase tracking-wide font-heading"
        >
          Full Trail Details &amp; Videos
        </a>
      </div>
    </div>
  </section>

  <!-- WHY MOUNTAIN BIKERS LOVE HIGH CAMP -->
  <section class="py-20 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-10">
        <h2 class="font-heading text-5xl md:text-6xl font-bold uppercase tracking-wide text-charcoal mb-4">Why Mountain Bikers Love High Camp</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-10">
        <div class="overflow-hidden h-64">
          <img
            src="/images/routes/mt-hough-trail-sign-mountain-bikers-lost-sierra.jpg"
            alt="Group of mountain bikers at the Mt. Hough trail sign in the Lost Sierra"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
          />
        </div>
        <div class="overflow-hidden h-64">
          <img
            src="/images/routes/high-camp-cabin-deck-gravel-bike-sunset.jpg"
            alt="Adirondack chairs and gravel bike on cabin deck at Beckwourth Peak High Camp at sunset"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
          />
        </div>
        <div class="overflow-hidden h-64">
          <img
            src="/images/routes/high-camp-riders-campfire-circle-evening.jpg"
            alt="Mountain bikers gathered in a circle around the fire pit at Beckwourth Peak High Camp"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
          />
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {reasons.map((r) => (
          <div class="bg-white p-7 shadow-md">
            <h3 class="font-heading text-xl font-bold uppercase tracking-wide text-charcoal mb-3">{r.title}</h3>
            <p class="text-charcoal/70 font-sans text-sm leading-relaxed">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SHUTTLE SERVICE -->
  <section class="py-16 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-10">
        <h2 class="font-heading text-4xl font-bold uppercase tracking-wide text-charcoal mb-3">Shuttle Service</h2>
      </div>
      <div class="grid grid-cols-1 gap-6 max-w-sm mx-auto">
        {shuttles.map((s) => (
          <div class="bg-white p-7 shadow-md">
            <h3 class="font-heading text-xl font-bold uppercase tracking-wide text-charcoal mb-2">{s.name}</h3>
            <p class="text-charcoal/70 font-sans text-sm leading-relaxed mb-4">{s.desc}</p>
            <a
              href={s.url}
              target="_blank"
              rel="noopener"
              class="text-cobalt hover:text-blue-600 font-sans text-sm font-bold transition-colors"
            >
              {s.label}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="py-20 bg-white">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-heading text-5xl md:text-6xl font-bold uppercase tracking-wide text-charcoal mb-4">Reviews from Mountain Bikers</h2>
        <div class="flex justify-center gap-1 text-gold text-xl">★★★★★</div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {testimonials.map((t) => (
          <div class="bg-cream border border-charcoal/10 p-5 flex flex-col gap-3">
            <div class="text-gold text-lg">★★★★★</div>
            <p class="text-charcoal/80 leading-relaxed italic flex-1 font-sans">"{t.text}"</p>
            <div class="border-t border-charcoal/10 pt-4">
              <p class="font-heading text-lg font-bold uppercase tracking-wide text-charcoal">{t.name}</p>
              <p class="text-charcoal/50 text-sm font-sans">{t.unit}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LODGING -->
  <section id="lodging" class="py-20 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-heading text-5xl md:text-6xl font-bold uppercase tracking-wide text-charcoal mb-4">Lodging Options</h2>
        <p class="text-charcoal/60 font-sans text-lg max-w-xl mx-auto">Two cabins, a yurt, and a campsite. Book one unit or all four for your group.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
        {lodging.map((unit) => (
          <div class="bg-white shadow-md flex flex-col">
            <div class="overflow-hidden h-48">
              <img src={unit.img} alt={unit.alt} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="p-6 flex flex-col gap-3 flex-1">
              <div>
                <h3 class="font-heading text-xl font-bold uppercase tracking-wide text-charcoal">{unit.name}</h3>
                <p class="text-cobalt text-sm font-bold mt-1">Sleeps {unit.sleeps} &bull; {unit.beds}</p>
              </div>
              <a
                href={unit.link}
                class="block text-center border-2 border-cobalt text-cobalt hover:bg-cobalt hover:text-white font-bold py-2 rounded text-sm transition-colors mt-auto uppercase tracking-wide font-heading"
              >
                View Details
              </a>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center">
        <a
          href="/lodging/entire-property"
          class="inline-block border-2 border-charcoal text-charcoal hover:bg-charcoal hover:text-white font-bold px-8 py-3 rounded text-sm transition-colors uppercase tracking-wide font-heading"
        >
          Book the Entire Property
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-charcoal text-white text-center">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-heading text-4xl md:text-5xl font-bold uppercase tracking-wide mb-4">Ready for Your Ultimate MTB Weekend?</h2>
      <p class="text-white/70 font-sans text-lg mb-8">Book your stay at High Camp and ride the Lost Sierra.</p>
      <a
        href={BOOK_URL}
        target="_blank"
        rel="noopener"
        class="inline-block bg-cobalt hover:bg-blue-600 text-white font-bold px-10 py-4 rounded text-lg transition-colors uppercase tracking-wide font-heading"
      >
        Book Your Stay
      </a>
    </div>
  </section>

  <Footer />
</Layout>
