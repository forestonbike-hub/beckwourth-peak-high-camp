---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const BOOK_URL = 'https://resnexus.com/resnexus/reservations/book/6C664BF8-3F89-4D87-9E83-DA82447501EB/';

const policies = [
  {
    title: 'Check-in & Check-out',
    items: [
      'Check-in: after 3:00 PM',
      'Check-out: before 11:00 AM',
      'If you need a different arrangement, reach out in advance and we\'ll do our best to accommodate.',
    ],
  },
  {
    title: 'Payment & Reservation',
    items: [
      'Credit card and full payment required at time of booking.',
      'The facility may charge your card during or after your stay for any additional fees generated by your visit.',
    ],
  },
  {
    title: 'Cancellation Policy',
    items: [
      '14+ days before arrival: full refund minus 5% processing fee.',
      'Less than 14 days before arrival: no refund.',
      'If the property closes unexpectedly or faces a government-enforced closure, guests receive a full refund.',
    ],
  },
  {
    title: 'Vehicle Limits',
    items: [
      'Cabins: 2 vehicles maximum.',
      'Yurt: 3 vehicles maximum (parked at the yurt).',
      'Campsite: 2 vehicles maximum.',
    ],
  },
  {
    title: 'Pets',
    items: [
      'No pets are permitted at High Camp.',
      'If anyone in your party brings a pet onto the property, you will be asked to leave immediately with no refund.',
      'Pets entering structures result in a $150 cleaning fee.',
    ],
  },
  {
    title: 'Smoking & Vaping',
    items: [
      'No smoking or vaping in or within 100 feet of any structure.',
      'A $500 fee applies if anyone in your party smokes or vapes near structures.',
    ],
  },
  {
    title: 'Quiet Hours',
    items: [
      'Quiet hours: 10:00 PM to 8:00 AM.',
      'Loud music disturbing other guests is prohibited at any time.',
      'Generators are not permitted.',
    ],
  },
  {
    title: 'Campfires & Grills',
    items: [
      'Campfires are only allowed in designated areas when no fire ban is in effect.',
      'Charcoal grills are prohibited.',
      'We follow all current Plumas National Forest fire restrictions and will notify guests of any limitations before arrival.',
    ],
  },
  {
    title: 'Prohibited Items',
    items: [
      'Firearms',
      'Fireworks',
      'Candles of any kind',
    ],
  },
  {
    title: 'Food & Waste',
    items: [
      'Do not leave food or trash outside. This is bear country.',
      'Feminine hygiene products, diapers, and wipes cannot be disposed of in toilets.',
    ],
  },
  {
    title: 'Guest Limits',
    items: [
      'No parties or extra guests are permitted without prior agreement.',
      'Groups exceeding the sleeping capacity of their unit may be asked to leave without a refund.',
    ],
  },
  {
    title: 'Access & Road Conditions',
    items: [
      'The final stretch to High Camp is a gravel forest road. Guests assume responsibility for vehicle damage on forest roads.',
      'See our <a href="/getting-here" class="text-cobalt hover:underline">Getting Here</a> page for road details and a preview video.',
    ],
  },
];
---

<Layout
  title="Policies | Beckwourth Peak High Camp"
  description="Guest policies for Beckwourth Peak High Camp: check-in, check-out, cancellation, pets, quiet hours, and property rules."
>
  <Nav />

  <!-- HERO -->
  <section class="relative h-[40vh] min-h-[300px] flex items-end overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/images/hero/beckwourth-peak-high-camp-panorama.jpg')"
    ></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/30 to-transparent"></div>
    <div class="relative z-10 max-w-8xl mx-auto px-6 pb-10 w-full">
      <p class="text-gold font-heading text-sm font-bold uppercase tracking-widest mb-2">Beckwourth Peak High Camp</p>
      <h1 class="font-heading text-5xl md:text-7xl font-bold uppercase tracking-wide text-white">Policies</h1>
      <p class="text-white/80 font-sans text-lg mt-2">What to know before your stay</p>
    </div>
  </section>

  <!-- CONTENT -->
  <section class="py-20 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-16">

        <!-- Left: Sticky nav -->
        <div class="hidden lg:block">
          <div class="sticky top-24 space-y-1">
            <p class="font-heading text-xs font-bold uppercase tracking-widest text-charcoal/40 mb-4">Jump to</p>
            {policies.map((section) => (
              <a
                href={`#${section.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
                class="block font-sans text-sm text-cobalt hover:text-blue-600 transition-colors py-1"
              >
                {section.title}
              </a>
            ))}
          </div>
        </div>

        <!-- Right: Policies content -->
        <div class="lg:col-span-3 space-y-12">
          {policies.map((section) => (
            <div id={section.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
              <h2 class="font-heading text-3xl font-bold uppercase tracking-wide text-charcoal mb-5 pb-4 border-b border-charcoal/10">
                {section.title}
              </h2>
              <ul class="space-y-3">
                {section.items.map((item) => (
                  <li class="flex items-start gap-3 font-sans text-base text-charcoal/80 leading-relaxed">
                    <span class="w-1.5 h-1.5 rounded-full bg-cobalt flex-shrink-0 mt-2"></span>
                    <span set:html={item} />
                  </li>
                ))}
              </ul>
            </div>
          ))}

          <!-- CTA -->
          <div class="text-center pt-4 border-t border-charcoal/10">
            <p class="font-sans text-charcoal/60 mb-2">Questions about our policies?</p>
            <p class="font-sans text-charcoal/60 mb-6">Email us at <a href="mailto:contact@beckwourthpeakhighcamp.com" class="text-cobalt hover:underline">contact@beckwourthpeakhighcamp.com</a></p>
            <a
              href={BOOK_URL}
              target="_blank"
              rel="noopener"
              class="inline-block bg-cobalt hover:bg-blue-600 text-white font-bold px-10 py-4 rounded text-sm transition-colors uppercase tracking-wide font-heading"
            >
              Check Availability
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <Footer />
</Layout>
