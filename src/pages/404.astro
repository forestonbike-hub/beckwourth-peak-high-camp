---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page Not Found | Beckwourth Peak High Camp"
  description="The page you're looking for doesn't exist. Head back to Beckwourth Peak High Camp to explore lodging, trails, and more."
>
  <Nav />

  <main class="min-h-[70vh] flex flex-col items-center justify-center px-6 py-24 text-center">
    <p class="font-heading text-cobalt text-lg font-bold uppercase tracking-widest mb-4">404</p>
    <h1 class="font-heading text-5xl md:text-6xl font-bold uppercase tracking-wide text-charcoal mb-6">
      Trail Not Found
    </h1>
    <p class="font-sans text-lg text-charcoal/70 max-w-md mb-10">
      Looks like you took a wrong turn. This page doesn't exist, but there's plenty to explore back at camp.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/"
        class="inline-block bg-cobalt text-white font-heading font-bold uppercase tracking-widest px-8 py-3 hover:bg-cobalt/90 transition-colors"
      >
        Back to Home
      </a>
      <a
        href="https://resnexus.com/resnexus/reservations/book/6C664BF8-3F89-4D87-9E83-DA82447501EB/"
        target="_blank"
        rel="noopener"
        class="inline-block border-2 border-charcoal text-charcoal font-heading font-bold uppercase tracking-widest px-8 py-3 hover:bg-charcoal hover:text-white transition-colors"
      >
        Check Availability
      </a>
    </div>
  </main>

  <Footer />
</Layout>
