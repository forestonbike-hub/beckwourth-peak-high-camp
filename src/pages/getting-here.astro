---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const BOOK_URL = 'https://resnexus.com/resnexus/reservations/book/6C664BF8-3F89-4D87-9E83-DA82447501EB/';
const WP = 'https://beckwourthpeakhighcamp.com/wp-content/uploads';

const MAPS_URL = 'https://www.google.com/maps?cid=5483882946058167542&g_mp=CiVnb29nbGUubWFwcy5wbGFjZXMudjEuUGxhY2VzLkdldFBsYWNlEAIYASAA&hl=en&gl=MX&source=embed';

const DIRT_ROAD_VIDEO_ID = '8APOBchLg5k';

const evStations = [
  {
    name: 'Downtown Portola',
    spots: '8 charging spots',
    distance: '1.5 miles from High Camp',
    maps: 'https://maps.google.com/?q=EV+charging+Portola+CA',
  },
  {
    name: 'Sierra Valley Preserve Nature Center',
    spots: '4 charging stations',
    distance: '7 miles from High Camp',
    maps: 'https://maps.google.com/?q=Sierra+Valley+Preserve+Nature+Center+CA',
    note: 'A great stop on the way home — easy bird and wildlife walks, information about the Sierra Valley.',
    photo: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2025/05/20250518_092650-240x300.jpg',
    photoAlt: 'EV charging stations at Sierra Valley Preserve Nature Center',
  },
];
---

<Layout
  title="Getting Here | Beckwourth Peak High Camp"
  description="Directions to Beckwourth Peak High Camp in the Lost Sierra near Portola, CA. Road conditions, EV charging, and what to expect on the drive in."
>
  <Nav />

  <!-- HERO -->
  <section class="relative h-[40vh] min-h-[300px] flex items-end overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style={`background-image: url('${WP}/2024/05/beckwourth-high-camp-3379-ig_53695514700_o-2.jpg')`}
    ></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/30 to-transparent"></div>
    <div class="relative z-10 max-w-8xl mx-auto px-6 pb-10 w-full">
      <p class="text-gold font-heading text-sm font-bold uppercase tracking-widest mb-2">Beckwourth Peak High Camp</p>
      <h1 class="font-heading text-5xl md:text-7xl font-bold uppercase tracking-wide text-white">Getting Here</h1>
    </div>
  </section>

  <!-- CONTENT -->
  <section class="py-20 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">

        <!-- Left: Main content -->
        <div class="lg:col-span-2 space-y-16">

          <!-- Directions -->
          <div>
            <h2 class="font-heading text-4xl font-bold uppercase tracking-wide text-charcoal mb-6">Driving to High Camp</h2>
            <p class="text-charcoal/80 font-sans text-lg leading-relaxed mb-6">
              High Camp is located inside the Plumas National Forest, just outside Portola, California. You'll leave the pavement and drive up a one-mile gravel road to reach the property.
            </p>
            <a
              href={MAPS_URL}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 bg-cobalt hover:bg-blue-600 text-white font-bold px-6 py-3 rounded text-sm transition-colors uppercase tracking-wide font-heading"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
              Open in Google Maps
            </a>
          </div>

          <!-- Forest Road -->
          <div>
            <h2 class="font-heading text-4xl font-bold uppercase tracking-wide text-charcoal mb-6">Forest Road to High Camp</h2>
            <p class="text-charcoal/80 font-sans text-lg leading-relaxed mb-4">
              High Camp is located inside the Plumas National Forest. From Portola, you'll leave the pavement and drive up a one-mile gravel road. Low-clearance vehicles could scrape on one dip in the road. For a preview, watch this video of the gravel road up to High Camp.
            </p>
            <div class="mt-6">
              <p class="font-heading text-sm font-bold uppercase tracking-widest text-charcoal/50 mb-3">Preview the road</p>
              <div class="relative w-full rounded shadow-md overflow-hidden" style="padding-top: 56.25%">
                <iframe
                  src={`https://www.youtube.com/embed/${DIRT_ROAD_VIDEO_ID}`}
                  title="Dirt road to Beckwourth Peak High Camp"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  class="absolute inset-0 w-full h-full"
                ></iframe>
              </div>
            </div>
          </div>

          <!-- EV Charging -->
          <div>
            <h2 class="font-heading text-4xl font-bold uppercase tracking-wide text-charcoal mb-6">EV Charging Nearby</h2>
            <p class="text-charcoal/80 font-sans text-lg leading-relaxed mb-8">
              High Camp does not have on-site EV charging, but there are two convenient options nearby.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {evStations.map((station) => (
                <div class="bg-white shadow-sm border border-charcoal/10 rounded overflow-hidden">
                  {station.photo && (
                    <img src={station.photo} alt={station.photoAlt} class="w-full h-48 object-cover" />
                  )}
                  <div class="p-6">
                  <p class="font-heading text-lg font-bold uppercase tracking-wide text-charcoal mb-1">{station.name}</p>
                  <p class="font-sans text-sm text-cobalt font-bold mb-1">{station.spots}</p>
                  <p class="font-sans text-sm text-charcoal/60 mb-3">{station.distance}</p>
                  {station.note && (
                    <p class="font-sans text-sm text-charcoal/70 leading-relaxed mb-4">{station.note}</p>
                  )}
                  <a
                    href={station.maps}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-1.5 text-cobalt hover:text-blue-600 font-sans text-sm font-bold transition-colors"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                    </svg>
                    Google Maps directions
                  </a>
                  </div>
                </div>
              ))}
            </div>
          </div>

        </div>

        <!-- Right: Quick facts + Book CTA -->
        <div>
          <div class="bg-white shadow-md p-8 sticky top-24">
            <p class="font-heading text-sm font-bold uppercase tracking-widest text-charcoal/40 mb-5">Quick Facts</p>
            <ul class="space-y-3 font-sans text-charcoal/80 mb-8">
              <li class="flex justify-between border-b border-charcoal/10 pb-3">
                <span class="text-charcoal/50">Location</span>
                <span class="font-bold text-right">Portola, CA</span>
              </li>
              <li class="flex justify-between border-b border-charcoal/10 pb-3">
                <span class="text-charcoal/50">Region</span>
                <span class="font-bold text-right">Lost Sierra</span>
              </li>
              <li class="flex justify-between border-b border-charcoal/10 pb-3">
                <span class="text-charcoal/50">Elevation</span>
                <span class="font-bold">5,300 ft</span>
              </li>
              <li class="flex justify-between border-b border-charcoal/10 pb-3">
                <span class="text-charcoal/50">Road</span>
                <span class="font-bold text-right">1 mi gravel road</span>
              </li>
              <li class="flex justify-between pb-3">
                <span class="text-charcoal/50">Season</span>
                <span class="font-bold">May – October</span>
              </li>
            </ul>
            <a
              href={MAPS_URL}
              target="_blank"
              rel="noopener"
              class="block text-center bg-charcoal hover:bg-black text-white font-bold px-6 py-4 rounded text-sm transition-colors uppercase tracking-wide font-heading w-full mb-3"
            >
              Get Directions
            </a>
            <a
              href={BOOK_URL}
              target="_blank"
              rel="noopener"
              class="block text-center bg-cobalt hover:bg-blue-600 text-white font-bold px-6 py-4 rounded text-sm transition-colors uppercase tracking-wide font-heading w-full"
            >
              Book Your Stay
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <Footer />
</Layout>
