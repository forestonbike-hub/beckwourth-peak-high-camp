---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const BOOK_URL = 'https://resnexus.com/resnexus/reservations/book/6C664BF8-3F89-4D87-9E83-DA82447501EB/';

const units = [
  {
    name: 'North Cabin',
    sleeps: 4,
    beds: '2 queen bunks',
    features: ['Private deck', 'Kitchen', 'Heat & A/C', 'Valley views'],
    img: '/images/lodging/north-cabin-valley-views.jpg',
    alt: 'North Cabin at Beckwourth Peak High Camp, Lost Sierra',
    link: '/lodging/north-cabin',
  },
  {
    name: 'South Cabin',
    sleeps: 4,
    beds: '2 queen bunks',
    features: ['Private deck', 'Kitchen', 'Heat & A/C', 'Valley views'],
    img: '/images/lodging/south-cabin-mountain-retreat.jpg',
    alt: 'South Cabin at Beckwourth Peak High Camp, Lost Sierra',
    link: '/lodging/south-cabin',
  },
  {
    name: 'The Yurt',
    sleeps: 5,
    beds: '4 beds + loft',
    features: ['Private deck', 'Skylight', 'Hardwood floors', 'Mountain views'],
    img: '/images/lodging/yurt-private-deck-mountains.jpg',
    alt: 'The Yurt at Beckwourth Peak High Camp, Lost Sierra',
    link: '/lodging/yurt',
  },
  {
    name: 'Campsite',
    sleeps: 5,
    beds: 'Bring your own tent',
    features: ['Tent platform', 'Picnic table', 'Bathhouse access', 'Fire ring'],
    img: '/images/lodging/campsite-tent-platform-lost-sierra.jpg',
    alt: 'Campsite at Beckwourth Peak High Camp, Lost Sierra',
    link: '/lodging/campsite',
  },
];

const sharedAmenities = [
  'Luxury bathhouse with private showers',
  'Communal fire pit',
  'Shaded picnic area with deck',
  '20-basket disc golf course',
  'Starlink WiFi',
  'On-site trail system',
  'Games and yard activities',
  '360° mountain views',
];

const idealFor = [
  {
    title: 'Group Rides',
    desc: 'Gravel routes and mountain bike trails leave right from the property. Rally your crew and ride all weekend.',
  },
  {
    title: 'Family Reunions',
    desc: 'Spread out across 65 acres with plenty of shared spaces to gather, from the fire pit to the shaded deck.',
  },
  {
    title: 'Corporate Retreats',
    desc: 'Disconnect from the office and reconnect as a team. Off-grid setting with Starlink WiFi when you need it.',
  },
  {
    title: 'Celebrations',
    desc: 'Birthdays, anniversaries, or just getting together with good people in a place that feels a world away.',
  },
];
---

<Layout
  title="Rent the Entire Property | Beckwourth Peak High Camp"
  description="Book all of Beckwourth Peak High Camp for your group. 65 acres, 4 units, up to 18 guests. Cabins, yurt, and campsite in the Lost Sierra near Portola, CA."
>
  <Nav />

  <!-- HERO -->
  <section class="relative h-[55vh] min-h-[380px] flex items-end overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/images/hero/beckwourth-peak-high-camp-panorama.jpg')"
    ></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
    <div class="relative z-10 max-w-8xl mx-auto px-6 pb-10 w-full">
      <p class="text-gold font-heading text-sm font-bold uppercase tracking-widest mb-2">Lodging at High Camp</p>
      <h1 class="font-heading text-5xl md:text-7xl font-bold uppercase tracking-wide text-white">Entire Property</h1>
      <p class="text-white/80 font-sans text-lg mt-2">Up to 18 Guests &bull; 65 Acres &bull; Lost Sierra, Portola CA</p>
    </div>
  </section>

  <!-- INTRO -->
  <section class="py-20 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">

        <!-- Left: Description -->
        <div class="lg:col-span-2">
          <h2 class="font-heading text-4xl font-bold uppercase tracking-wide text-charcoal mb-6">The Whole Place Is Yours</h2>
          <p class="text-charcoal/80 font-sans text-lg leading-relaxed mb-4">
            Book every unit at High Camp and have 65 acres of mountain property to yourselves. Two cabins, a yurt, and a campsite spread across the ridgeline, each with its own private space but connected by trails, a shared bathhouse, and a communal fire pit under some of the darkest skies in California.
          </p>
          <p class="text-charcoal/80 font-sans text-lg leading-relaxed mb-4">
            Whether you're organizing a group ride, planning a family reunion, or just want to gather your people somewhere that feels a world away, High Camp gives you room to spread out without losing the feeling of being together.
          </p>
          <p class="text-charcoal/80 font-sans text-lg leading-relaxed">
            Gravel routes and mountain bike singletrack leave right from the property. A 20-basket disc golf course winds through the pines. And at the end of the day, everyone comes back to the fire pit, hot showers, and a sky full of stars.
          </p>
        </div>

        <!-- Right: Stats + Book CTA -->
        <div>
          <div class="bg-white shadow-md p-8 sticky top-24">
            <p class="font-heading text-sm font-bold uppercase tracking-widest text-charcoal/40 mb-5">The Details</p>
            <ul class="space-y-3 font-sans text-charcoal/80 mb-6">
              <li class="flex justify-between border-b border-charcoal/10 pb-3">
                <span class="text-charcoal/50">Total Guests</span>
                <span class="font-bold">Up to 18</span>
              </li>
              <li class="flex justify-between border-b border-charcoal/10 pb-3">
                <span class="text-charcoal/50">Units</span>
                <span class="font-bold">4 (2 cabins, yurt, campsite)</span>
              </li>
              <li class="flex justify-between border-b border-charcoal/10 pb-3">
                <span class="text-charcoal/50">Acreage</span>
                <span class="font-bold">65 acres</span>
              </li>
              <li class="flex justify-between border-b border-charcoal/10 pb-3">
                <span class="text-charcoal/50">Elevation</span>
                <span class="font-bold">5,300 ft</span>
              </li>
              <li class="flex justify-between pb-3">
                <span class="text-charcoal/50">Season</span>
                <span class="font-bold">May – October</span>
              </li>
            </ul>
            <a
              href={BOOK_URL}
              target="_blank"
              rel="noopener"
              class="block text-center bg-cobalt hover:bg-blue-600 text-white font-bold px-6 py-4 rounded text-sm transition-colors uppercase tracking-wide font-heading w-full"
            >
              Check Availability
            </a>
            <p class="text-charcoal/40 text-xs font-sans text-center mt-3">Book all units for your group</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- UNITS OVERVIEW -->
  <section class="py-20 bg-white">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-heading text-5xl md:text-6xl font-bold uppercase tracking-wide text-charcoal mb-4">What's Included</h2>
        <p class="text-charcoal/60 font-sans text-lg max-w-2xl mx-auto">Four separate units, each with its own space and character. All guests share the bathhouse, fire pit, and 65 acres.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {units.map((unit) => (
          <div class="bg-cream overflow-hidden shadow-md group">
            <div class="relative h-52 overflow-hidden">
              <img
                src={unit.img}
                alt={unit.alt}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-5 flex flex-col gap-3">
              <div>
                <h3 class="font-heading text-2xl font-bold uppercase tracking-wide text-charcoal">{unit.name}</h3>
                <p class="text-cobalt text-sm font-bold mt-0.5">Sleeps {unit.sleeps} &bull; {unit.beds}</p>
              </div>
              <ul class="space-y-1.5">
                {unit.features.map((f) => (
                  <li class="flex items-center gap-2 font-sans text-sm text-charcoal/70">
                    <span class="w-1.5 h-1.5 rounded-full bg-cobalt flex-shrink-0"></span>
                    {f}
                  </li>
                ))}
              </ul>
              <a
                href={unit.link}
                class="block text-center border-2 border-cobalt text-cobalt hover:bg-cobalt hover:text-white font-bold py-2 rounded text-sm transition-colors mt-1 uppercase tracking-wide font-heading"
              >
                View Details
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SHARED AMENITIES -->
  <section class="py-16 bg-charcoal text-white">
    <div class="max-w-8xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="font-heading text-4xl font-bold uppercase tracking-wide mb-6">Shared Spaces & Amenities</h2>
          <p class="text-white/70 font-sans text-lg leading-relaxed mb-8">
            Every guest has access to everything on the property, from the bathhouse to the disc golf course.
          </p>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {sharedAmenities.map((item) => (
              <li class="flex items-center gap-3 font-sans text-white/80">
                <span class="w-1.5 h-1.5 rounded-full bg-cobalt flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <img
            src="/images/lodging/bathhouse-exterior-showers.jpg"
            alt="Shared bathhouse with private showers at Beckwourth Peak High Camp"
            class="w-full h-48 object-cover"
          />
          <img
            src="/images/activities/disc-golf-course-pines.jpg"
            alt="20-basket disc golf course at Beckwourth Peak High Camp"
            class="w-full h-48 object-cover"
          />
          <img
            src="/images/activities/campfire-under-stars.jpg"
            alt="Campfire under the stars at Beckwourth Peak High Camp"
            class="w-full h-48 object-cover"
          />
          <img
            src="/images/lodging/glamping-cabin-comfort.jpg"
            alt="Comfortable glamping at Beckwourth Peak High Camp"
            class="w-full h-48 object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- IDEAL FOR -->
  <section class="py-20 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-heading text-5xl md:text-6xl font-bold uppercase tracking-wide text-charcoal mb-4">Perfect For</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {idealFor.map((item) => (
          <div class="bg-white p-7 shadow-md">
            <h3 class="font-heading text-xl font-bold uppercase tracking-wide text-charcoal mb-3">{item.title}</h3>
            <p class="text-charcoal/70 font-sans text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-charcoal text-white text-center">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-heading text-4xl md:text-5xl font-bold uppercase tracking-wide mb-4">Ready to Book the Whole Place?</h2>
      <p class="text-white/70 font-sans text-lg mb-8">Check availability for all four units and plan your group getaway in the Lost Sierra.</p>
      <a
        href={BOOK_URL}
        target="_blank"
        rel="noopener"
        class="inline-block bg-cobalt hover:bg-blue-600 text-white font-bold px-10 py-4 rounded text-lg transition-colors uppercase tracking-wide font-heading"
      >
        Check Availability
      </a>
    </div>
  </section>

  <Footer />
</Layout>
