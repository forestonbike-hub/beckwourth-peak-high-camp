---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const BOOK_URL = 'https://resnexus.com/resnexus/reservations/book/6C664BF8-3F89-4D87-9E83-DA82447501EB/';
const WP = 'https://beckwourthpeakhighcamp.com/wp-content/uploads';

const photos = [
  { src: `${WP}/2024/05/beckwourth-high-camp-3401-ig_53695282643_o-1-1024x1024.jpg`, alt: 'North Cabin exterior at Beckwourth Peak High Camp, Lost Sierra' },
  { src: `${WP}/2024/05/beckwourth-high-camp-3401-ig_53695282643_o-1-1024x1024.jpg`, alt: 'North Cabin interior at Beckwourth Peak High Camp' },
  { src: `${WP}/2024/05/beckwourth-high-camp-3401-ig_53695282643_o-1-1024x1024.jpg`, alt: 'North Cabin private deck with mountain views, Beckwourth Peak High Camp' },
  { src: `${WP}/2024/05/beckwourth-high-camp-3401-ig_53695282643_o-1-1024x1024.jpg`, alt: 'North Cabin kitchen and living area at Beckwourth Peak High Camp' },
];

const amenities = [
  { icon: '🛏', label: 'Sleeps 4' },
  { icon: '🍳', label: 'Full Kitchen' },
  { icon: '🚿', label: 'Shared Bathhouse' },
  { icon: '📶', label: 'Starlink WiFi' },
  { icon: '🪑', label: 'Private Deck' },
  { icon: '🏔', label: 'Valley Views' },
  { icon: '🔥', label: 'Communal Fire Pit' },
  { icon: '🥏', label: 'Disc Golf Course' },
];

const beds = [
  { type: 'Queen Bed', count: 1 },
  { type: 'Twin Bunk', count: 1 },
];
---

<Layout
  title="North Cabin | Beckwourth Peak High Camp"
  description="Sleeps 4. Modern cabin with a private deck, full kitchen, and sweeping valley views in the Lost Sierra near Portola, CA."
>
  <Nav />

  <!-- HERO -->
  <section class="relative h-[60vh] min-h-[400px] flex items-end overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat"
      style={`background-image: url('${WP}/2024/05/beckwourth-high-camp-3401-ig_53695282643_o-1-1024x1024.jpg')`}
    ></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
    <div class="relative z-10 max-w-8xl mx-auto px-6 pb-12 w-full">
      <p class="text-gold font-heading text-sm font-bold uppercase tracking-widest mb-2">Lodging</p>
      <h1 class="font-heading text-5xl md:text-7xl font-bold uppercase tracking-wide text-white">North Cabin</h1>
      <p class="text-white/80 font-sans text-lg mt-2">Sleeps 4 &bull; Portola, CA &bull; Plumas National Forest</p>
    </div>
  </section>

  <!-- PHOTO GRID -->
  <section class="bg-charcoal py-3 px-3">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 max-w-8xl mx-auto">
      {photos.map((photo, i) => (
        <div class={`overflow-hidden ${i === 0 ? 'md:col-span-2 md:row-span-2' : ''}`}>
          <img
            src={photo.src}
            alt={photo.alt}
            class={`w-full object-cover hover:scale-105 transition-transform duration-500 ${i === 0 ? 'h-64 md:h-full' : 'h-48'}`}
          />
        </div>
      ))}
    </div>
  </section>

  <!-- OVERVIEW -->
  <section class="py-20 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">

        <!-- Description -->
        <div class="lg:col-span-2">
          <h2 class="font-heading text-4xl font-bold uppercase tracking-wide text-charcoal mb-6">About the Cabin</h2>
          <p class="text-charcoal/80 font-sans text-lg leading-relaxed mb-4">
            The North Cabin is a modern, well-appointed retreat tucked into the pines on 65 acres of Beckwourth Peak. Step out onto your private deck and take in sweeping valley views stretching across Plumas National Forest — with no neighbors in sight.
          </p>
          <p class="text-charcoal/80 font-sans text-lg leading-relaxed mb-4">
            With a full kitchen, comfortable beds, and Adirondack chairs on the deck, it's designed for the kind of trip where you actually unwind. The South Cabin is 100 yards away and out of sight — close enough to coordinate a group trip, far enough to feel like your own place.
          </p>
          <p class="text-charcoal/80 font-sans text-lg leading-relaxed">
            Trails leave right from the property. Gravel routes, mountain bike singletrack, and hiking terrain are all within minutes. Come back to a hot shower, a campfire, and a sky full of stars.
          </p>
        </div>

        <!-- Quick Stats + Book CTA -->
        <div class="bg-white shadow-md p-8">
          <div class="mb-6">
            <p class="font-heading text-sm font-bold uppercase tracking-widest text-charcoal/40 mb-4">The Details</p>
            <ul class="space-y-3 font-sans text-charcoal/80">
              <li class="flex items-center gap-3"><span class="text-cobalt font-bold">4</span> Guests max</li>
              <li class="flex items-center gap-3"><span class="text-cobalt font-bold">1</span> Queen bed</li>
              <li class="flex items-center gap-3"><span class="text-cobalt font-bold">1</span> Twin bunk</li>
              <li class="flex items-center gap-3"><span class="text-cobalt font-bold">1</span> Full bathroom (shared)</li>
              <li class="flex items-center gap-3"><span class="text-cobalt font-bold">65</span> Acres of property</li>
              <li class="flex items-center gap-3"><span class="text-cobalt font-bold">5,300</span> ft elevation</li>
            </ul>
          </div>
          <div class="border-t border-charcoal/10 pt-6">
            <p class="text-charcoal/50 text-xs font-sans mb-4">Open May through October. Book directly for best availability.</p>
            <a
              href={BOOK_URL}
              target="_blank"
              rel="noopener"
              class="block text-center bg-cobalt hover:bg-blue-600 text-white font-bold px-6 py-4 rounded text-sm transition-colors uppercase tracking-wide font-heading w-full"
            >
              Check Availability
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- AMENITIES -->
  <section class="py-20 bg-white">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="font-heading text-sm font-bold uppercase tracking-widest text-charcoal/40 mb-3">What's Included</p>
        <h2 class="font-heading text-5xl md:text-6xl font-bold uppercase tracking-wide text-charcoal">Amenities</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 max-w-3xl mx-auto">
        {amenities.map((item) => (
          <div class="text-center p-6 bg-cream">
            <div class="text-3xl mb-3">{item.icon}</div>
            <p class="font-sans text-sm font-bold text-charcoal/70 uppercase tracking-wide">{item.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EDITORIAL PANEL -->
  <section class="relative h-80 overflow-hidden flex items-center justify-center">
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat"
      style={`background-image: url('${WP}/2024/05/beckwourth-high-camp-3379-ig_53695514700_o-2-1024x1024.jpg')`}
    ></div>
    <div class="absolute inset-0 bg-black/55"></div>
    <div class="relative z-10 text-center px-6">
      <p class="font-heading text-sm font-bold uppercase tracking-widest text-gold mb-3">Beckwourth Peak High Camp</p>
      <p class="font-heading text-3xl md:text-4xl font-bold uppercase tracking-wide text-white">Trails Out Your Door. Hot Showers Waiting.</p>
    </div>
  </section>

  <!-- OTHER UNITS -->
  <section class="py-20 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="font-heading text-sm font-bold uppercase tracking-widest text-charcoal/40 mb-3">Also Available</p>
        <h2 class="font-heading text-5xl md:text-6xl font-bold uppercase tracking-wide text-charcoal">More Ways to Stay</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <a href="/lodging/south-cabin" class="group bg-white shadow-md hover:shadow-xl transition-shadow overflow-hidden">
          <div class="h-48 overflow-hidden">
            <img
              src="https://beckwourthpeakhighcamp.com/wp-content/uploads/2024/05/beckwourth-high-camp-3348-ig_53695421374_o-2.jpg"
              alt="South Cabin at Beckwourth Peak High Camp, Lost Sierra"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-5">
            <p class="font-heading text-xs font-bold uppercase tracking-widest text-charcoal/40 mb-1">Sleeps 4</p>
            <h3 class="font-heading text-xl font-bold uppercase tracking-wide text-charcoal">South Cabin</h3>
            <p class="font-sans text-sm text-charcoal/60 mt-2">Same comfort, sun-facing deck, 100 yards from the North.</p>
          </div>
        </a>
        <a href="/lodging/yurt" class="group bg-white shadow-md hover:shadow-xl transition-shadow overflow-hidden">
          <div class="h-48 overflow-hidden">
            <img
              src={`${WP}/2025/07/20250608_090013-EDIT-1-1024x768.jpg`}
              alt="Yurt rental at Beckwourth Peak High Camp, Portola CA"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-5">
            <p class="font-heading text-xs font-bold uppercase tracking-widest text-charcoal/40 mb-1">Sleeps 5</p>
            <h3 class="font-heading text-xl font-bold uppercase tracking-wide text-charcoal">The Yurt</h3>
            <p class="font-sans text-sm text-charcoal/60 mt-2">Hardwood floors, 4 beds, private deck and a skylight for stargazing.</p>
          </div>
        </a>
        <a href="/lodging/campsite" class="group bg-white shadow-md hover:shadow-xl transition-shadow overflow-hidden">
          <div class="h-48 overflow-hidden">
            <img
              src={`${WP}/2024/06/20240608_143013-1024x768.jpg`}
              alt="Private campsite at Beckwourth Peak High Camp, Lost Sierra"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-5">
            <p class="font-heading text-xs font-bold uppercase tracking-widest text-charcoal/40 mb-1">Sleeps 5</p>
            <h3 class="font-heading text-xl font-bold uppercase tracking-wide text-charcoal">Campsite</h3>
            <p class="font-sans text-sm text-charcoal/60 mt-2">Your own private site with full bathhouse access.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
