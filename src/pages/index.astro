    <div class="max-w-8xl mx-auto px-6">
      <p class="text-center text-charcoal/40 text-xs font-bold uppercase tracking-widest mb-7 font-sans">We Proudly Support</p>
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
        {partners.map((p) => (
          <img
            src={p.img}
            alt={p.name}
            class="h-10 w-auto object-contain opacity-50 hover:opacity-80 transition-opacity"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- INSTAGRAM -->
  <section class="py-20 bg-white">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-10">
        <h2 class="font-heading text-5xl font-bold uppercase tracking-wide text-charcoal mb-2">Follow Along</h2>
        <a
