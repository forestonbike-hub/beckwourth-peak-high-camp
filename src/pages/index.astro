---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const BOOK_URL = 'https://resnexus.com/resnexus/reservations/book/6C664BF8-3F89-4D87-9E83-DA82447501EB/';
const WP = 'https://beckwourthpeakhighcamp.com/wp-content/uploads';

const lodging = [
  {
    name: 'North Cabin',
    sleeps: 4,
    desc: 'A modern cabin with a kitchen, private deck, Adirondack chairs, and sweeping valley views. 100 yards and out of sight from the South Cabin.',
    alt: 'Modern cabin rental for mountain bikers at Beckwourth Peak High Camp, Lost Sierra',
    img: `${WP}/2024/05/beckwourth-high-camp-3401-ig_53695282643_o-1-1024x1024.jpg`,
  },
  {
    name: 'South Cabin',
    sleeps: 4,
    desc: 'A modern cabin with a kitchen, private deck, Adirondack chairs, and sweeping valley views. 100 yards and out of sight from the North Cabin.',
    alt: 'Off-grid cabin rental near gravel biking trails at Beckwourth Peak High Camp',
    img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2024/05/beckwourth-high-camp-3348-ig_53695421374_o-2.jpg',
  },
  {
    name: 'The Yurt',
    sleeps: 5,
    desc: 'Hardwood floors, 4 beds, private deck and a skylight window for stargazing. More than 100 yards from other units.',
    alt: 'Yurt rental with stargazing skylight at Beckwourth Peak High Camp, Portola CA',
    img: `${WP}/2025/07/20250608_090013-EDIT-1-1024x768.jpg`,
  },
  {
    name: 'Campsite',
    sleeps: 5,
    desc: 'Your own private site with a picnic table and full access to our bathhouse, campfire, shaded picnic area and other amenities.',
    alt: 'Private campsite with bathhouse access at Beckwourth Peak High Camp, Lost Sierra',
    img: `${WP}/2024/06/20240608_143013-1024x768.jpg`,
  },
];

const amenities = [
  {
    label: 'Luxury Bathhouse',
    svg: '<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />',
  },
  {
    label: 'Cozy Campfire',
    svg: '<path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925 3.546 5.974 5.974 0 01-2.133-1A3.75 3.75 0 0012 18z" />',
  },
  {
    label: 'Starlink WiFi',
    svg: '<path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 011.06 0z" />',
  },
  {
    label: 'Disc Golf & Games',
    svg: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />',
  },
  {
    label: 'Trail System',
    svg: '<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" />',
  },
  {
    label: 'Shaded Picnic Area',
    svg: '<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />',
  },
];

const activities = [
  {
    name: 'Biking',
    desc: 'Gravel routes and mountain bike trails leave right from High Camp. Mt. Hough and Mills Peak are nearby.',
    alt: 'Mountain biking and gravel cycling at Beckwourth Peak High Camp, Lost Sierra California',
    img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2026/04/Screenshot-2026-04-08-11.02.02-AM.jpg',
    bg: '',
  },
  {
    name: 'Campfires',
    desc: "Gather around the fire pit under the stars. We'll bring the chairs!",
    alt: 'Campfire under the stars at Beckwourth Peak High Camp glamping, Portola CA',
    img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2026/04/campfire1-300x225.jpg',
    bg: '',
  },
  {
    name: 'Hiking',
    desc: 'Our trails connect to Beckwourth Peak Recreation Project, offering 19 miles of trail and 360° views.',
    alt: 'Hiking trails at Beckwourth Peak Recreation Project near Portola, California',
    img: `${WP}/2023/10/20220512_171221-1024x557.jpg`,
    bg: '',
  },
  {
    name: 'Disc Golf',
    desc: 'Play our on-property 20-basket disc golf course winding through the pines.',
    alt: '20-basket disc golf course at Beckwourth Peak High Camp, Lost Sierra',
    img: `${WP}/2025/07/20250607_200829.jpg`,
    bg: '',
  },
  {
    name: 'Stargazing',
    desc: 'Dark Sky Community. 5,300 feet. Minimal light pollution. The rest is up to the sky.',
    alt: 'Dark sky stargazing at Beckwourth Peak High Camp, Lost Sierra California',
    img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2026/04/stars1-300x300.jpg',
    bg: '',
  },
  {
    name: 'Events',
    desc: 'From biking getaways to family reunions to microweddings and elopements, High Camp is a great place to connect.',
    alt: 'Group retreats and events at Beckwourth Peak High Camp, Plumas County California',
    img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2026/04/events.jpg',
    bg: '',
  },
];

const attractions = [
  {
    name: 'Mt. Hough Trails',
    distance: '20 miles',
    desc: '50+ miles of singletrack, with 3,800 vertical feet of flowy, fast descent.',
    alt: 'Mt. Hough mountain biking singletrack trails near Quincy, California Lost Sierra',
    color: 'from-[#2a4a1a] to-[#1a3010]',
    img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2026/04/my-hogh.jpg',
  },
  {
    name: 'Lakes Basin',
    distance: '22 miles',
    desc: 'Gold Lake, Sardine Lakes & countless places to swim, boat or hike.',
    alt: 'Lakes Basin Gold Lake swimming and hiking near Portola, California',
    color: 'from-[#1a4a6b] to-[#0e3050]',
    img: 'https://upload.wikimedia.org/wikipedia/commons/2/21/Upper_Sardine_Lake_and_the_Sierra_Buttes%2C_California.jpg',
  },
  {
    name: 'Graeagle',
    distance: '8 miles',
    desc: 'A charming mountain village with golf, fishing, minigolf and dining.',
    alt: 'Graeagle mountain village near Beckwourth Peak High Camp, Lost Sierra California',
    color: 'from-[#4a5c2a] to-[#3a4a20]',
    img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2026/04/Graeagle-1500x430-1.jpg',
  },
  {
    name: 'Frazier Falls',
    distance: '25 miles',
    desc: 'A 2-mile trail leads to a 176-foot waterfall in Plumas National Forest.',
    alt: 'Frazier Falls 176-foot waterfall hike in Plumas National Forest near Portola',
    color: 'from-[#1a5a4a] to-[#0e3a30]',
    img: 'https://upload.wikimedia.org/wikipedia/commons/5/54/Frazier_Creek_Falls_-_Plumas_National_Forest_-_California.jpg',
  },
  {
    name: 'Golf',
    distance: '5 miles',
    desc: 'World-class courses at Grizzly Ranch, Nakoma, & Graeagle Meadows.',
    alt: 'Grizzly Ranch golf course near Beckwourth Peak High Camp, Plumas County',
    color: 'from-[#2a5c2a] to-[#1a3a1a]',
    img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2026/04/Grizzly-Ranch-GC-1.jpg',
  },
  {
    name: 'Sierra Valley Preserve',
    distance: '7 miles',
    desc: 'Interactive exhibits, interpretive trails, birding, and picnic areas.',
    alt: 'Sierra Valley wildlife preserve mountain meadow near Portola, California',
    color: 'from-[#2a5c3a] to-[#1a3a25]',
    img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2026/04/images-4.jpeg',
  },
  {
    name: 'Portola Railroad Museum',
    distance: '2 miles',
    desc: 'Climb aboard and drive historic locomotives.',
    alt: 'Portola Railroad Museum historic locomotives near Beckwourth Peak High Camp',
    color: 'from-[#4a2a5c] to-[#2a1a3a]',
    img: 'https://upload.wikimedia.org/wikipedia/commons/f/f6/The_Western_Pacific_Railroad_Museum_in_Portola%2C_CA_%2810143267775%29.jpg',
  },
  {
    name: 'The Brewing Lair',
    distance: '8 miles',
    desc: 'A craft brewery tucked in the forest with games, music and plenty of room to relax.',
    alt: 'The Brewing Lair craft brewery near Graeagle and Beckwourth Peak High Camp',
    color: 'from-[#5c4a1a] to-[#3a2e10]',
    img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2026/04/brewering-liar-patio.jpg',
  },
];

const testimonials = [
  {
    name: 'Ollie',
    text: "You owe it to yourself to experience this place! Site and facilities are immaculate, with everything you'd need. Views from the top of the ridge and from the cabins are magic. Best camp experience we've had in CA.",
    unit: 'Cabin Guest',
  },
  {
    name: 'Matt',
    text: "This off-grid tiny-home was exactly what we were looking for — comfortable with access to amazing trails. At night, the sky took center stage. There's little light pollution up here, so the Milky Way was on full display.",
    unit: 'Cabin Guest',
  },
  {
    name: 'Christa',
    text: 'An amazing spot for a bikepacking trip. Forest the host was awesome and made routes to optimize our trip. We stayed in the yurt and it was clean, spacious, well stocked and super comfy. Truly a bikepacking glamping experience.',
    unit: 'Yurt Guest',
  },
];

const partners = [
  { name: 'Sierra Buttes Trail Stewardship', img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2025/02/SBTS-Logo-Jpg-BIg.avif' },
  { name: 'Backcountry Discovery Routes', img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2024/12/backcountry-discovery-routes-sm.avif' },
  { name: 'Lost Sierra MTB', img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2024/12/LostSierraMTB.avif' },
  { name: 'Adventure Cycling Association', img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2024/12/ACA-1.png' },
  { name: 'Ride with GPS', img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2024/12/ambassador_160.png' },
];

const editorialPanels = [
  {
    label: 'Comfort',
    headline: 'Unwind in Comfort',
    alt: 'Comfortable off-grid glamping accommodations at Beckwourth Peak High Camp, Lost Sierra',
    img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2024/05/beckwourth-high-camp-3348-ig_53695421374_o-2-768x768.jpg',
  },
  {
    label: 'Adventure',
    headline: 'trails outside your door',
    alt: 'Mountain biking and gravel cycling trails at Beckwourth Peak High Camp, Lost Sierra',
    img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2024/05/5-bucks-gravel-24-3434-ig_53695515155_o-2-768x768.jpg',
  },
  {
    label: 'Solitude',
    headline: 'Room to Breathe',
    alt: 'Off-grid retreat in Plumas National Forest near Portola, California',
    img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2024/05/beckwourth-high-camp-3394-ig_53694184967_o-768x768.jpg',
  },
];

const instagramPhotos = [
  { img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2025/09/PXL_20241006_212152820-EDIT.jpg', alt: 'Off-grid glamping at Beckwourth Peak High Camp, Lost Sierra California', url: 'https://www.instagram.com/p/DW4oqLEgasv/' },
  { img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2026/04/Screenshot-2026-04-08-10.55.45-AM.jpg', alt: 'Gravel cycling base camp at Beckwourth Peak High Camp, Portola CA', url: 'https://www.instagram.com/beckwourthpeakhighcamp/p/DOguXT5gdlo/' },
  { img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2026/04/Screenshot-2026-04-08-10.54.05-AM.jpg', alt: 'Mountain biking trails near Beckwourth Peak High Camp, Lost Sierra', url: 'https://www.instagram.com/beckwourthpeakhighcamp/p/DKnfNMnM7Xq/' },
  { img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2026/04/Screenshot-2026-04-08-11.01.06-AM.jpg', alt: 'Cabin glamping at Beckwourth Peak High Camp, Plumas National Forest', url: 'https://www.instagram.com/p/DKKS4Oxx4RJ/' },
  { img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2026/04/Screenshot-2026-04-08-12.23.02-PM.jpg', alt: 'Beckwourth Peak High Camp outdoor retreat, Lost Sierra California', url: 'https://www.instagram.com/p/DEN1aYJvvAw/' },
  { img: 'https://beckwourthpeakhighcamp.com/wp-content/uploads/2026/04/Screenshot-2026-04-08-10.56.21-AM.jpg', alt: 'Gravel biking and glamping at Beckwourth Peak High Camp, Portola CA', url: 'https://www.instagram.com/beckwourthpeakhighcamp/p/DQz6V7gEfEl/' },
];
---

<Layout title="Beckwourth Peak High Camp | Off-Grid Glamping in the Lost Sierra">

  <Nav />

  <!-- HERO -->
  <section class="relative h-screen min-h-[600px] flex items-center justify-center overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat"
      style={`background-image: url('${WP}/2024/05/beckwourth-high-camp-3379-ig_53695514700_o-2-1024x1024.jpg')`}
    ></div>
    <div class="absolute inset-0 bg-black/45"></div>
    <div class="relative z-10 text-center text-white px-6 max-w-4xl mx-auto">
      <p class="text-gold text-sm font-sans font-bold uppercase tracking-widest mb-4">Portola, CA</p>
      <h1 class="font-heading text-6xl md:text-7xl lg:text-8xl font-bold uppercase leading-none tracking-wide mb-6">
        Your Base Camp<br />in the Lost Sierra
      </h1>
      <p class="text-lg md:text-xl text-white/90 mb-8 leading-relaxed max-w-xl mx-auto font-sans">
        Off-grid retreat on 65 acres in Plumas National Forest.<br class="hidden md:block" />Modern cabins, mountain views, and trails out your door.
      </p>
      <a
        href={BOOK_URL}
        target="_blank"
        rel="noopener"
        class="inline-block bg-cobalt hover:bg-blue-600 text-white font-bold px-10 py-4 rounded text-lg transition-colors uppercase tracking-wide font-heading"
      >
        Check Availability
      </a>
    </div>
  </section>

  <!-- STATS BAR -->
  <section class="bg-charcoal text-white py-5">
    <div class="max-w-8xl mx-auto px-6">
      <ul class="flex flex-wrap items-center justify-center gap-x-0 gap-y-2 text-sm font-sans font-bold uppercase tracking-wider">
        <li class="px-6 border-r border-white/20 text-center">65 Acres</li>
        <li class="px-6 border-r border-white/20 text-center">5,300 ft Elevation</li>
        <li class="px-6 border-r border-white/20 text-center">Biking & Hiking</li>
        <li class="px-6 border-r border-white/20 text-center">Starlink WiFi</li>
        <li class="px-6 text-center text-gold">360° Views</li>
      </ul>
    </div>
  </section>

  <!-- LODGING -->
  <section id="lodging" class="py-20 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-heading text-5xl md:text-6xl font-bold uppercase tracking-wide text-charcoal mb-4">Where You'll Stay</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {lodging.map((unit) => (
          <div class="bg-white overflow-hidden shadow-md hover:shadow-xl transition-shadow group">
            <div class="relative h-52 overflow-hidden">
              <img
                src={unit.img}
                alt={unit.alt}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-5 flex flex-col gap-3">
              <div>
                <h3 class="font-heading text-2xl font-bold uppercase tracking-wide text-charcoal">{unit.name}</h3>
                <p class="text-cobalt text-sm font-bold mt-0.5">Sleeps {unit.sleeps}</p>
              </div>
              <p class="text-charcoal/70 text-sm leading-relaxed flex-1 font-sans">{unit.desc}</p>
              <a
                href={BOOK_URL}
                target="_blank"
                rel="noopener"
                class="block text-center bg-cobalt hover:bg-blue-600 text-white font-bold py-2.5 rounded text-sm transition-colors mt-1 uppercase tracking-wide font-heading"
              >
                Book This Unit
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Bathhouse callout -->
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 overflow-hidden shadow-md">
        <div class="h-64 md:h-auto overflow-hidden">
          <img
            src="https://beckwourthpeakhighcamp.com/wp-content/uploads/2024/01/20230925_103639.jpg"
            alt="Shared bathhouse with private shower stalls at Beckwourth Peak High Camp"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="bg-charcoal text-white px-10 py-10 flex flex-col justify-center">
          <p class="text-gold text-xs font-bold uppercase tracking-widest mb-3 font-sans">Shared by All Guests</p>
          <h3 class="font-heading text-3xl font-bold uppercase tracking-wide mb-4">The Bathhouse</h3>
          <p class="font-sans text-white/75 text-base leading-relaxed">
            Our on-site bathhouse has private shower stalls, changing rooms, and plenty of hot water. No private bathrooms in the units -- but this is the next best thing after a long day on the trail.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- AMENITIES -->
  <section class="py-16 bg-charcoal text-white">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-10">
        <h2 class="font-heading text-5xl font-bold uppercase tracking-wide mb-3">Shared Amenities</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-px bg-white/10">
        {amenities.map((a) => (
          <div class="bg-charcoal px-6 py-8 text-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-9 h-9 text-cobalt mx-auto mb-4"
            >
              <Fragment set:html={a.svg} />
            </svg>
            <p class="font-heading text-base font-semibold uppercase tracking-wider text-white">{a.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EDITORIAL PANELS -->
  <section class="bg-charcoal">
    <div class="grid grid-cols-1 md:grid-cols-3">
      {editorialPanels.map((panel) => (
        <div class="relative h-96 overflow-hidden group">
          <img
            src={panel.img}
            alt={panel.alt}
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
            <p class="text-gold text-xs font-bold uppercase tracking-widest mb-2 font-sans">{panel.label}</p>
            <p class="font-heading text-2xl font-bold uppercase tracking-wide leading-tight">{panel.headline}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ACTIVITIES -->
  <section id="activities" class="py-20 bg-white">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-heading text-5xl md:text-6xl font-bold uppercase tracking-wide text-charcoal mb-4">Explore High Camp</h2>
      </div>
      <div class="flex flex-wrap justify-center gap-5">
        {activities.map((activity) => (
          <div
            class={`relative overflow-hidden w-full sm:w-[calc(50%-10px)] lg:w-[calc(33.333%-14px)] min-w-[280px] max-w-[480px] h-80 group cursor-default flex-shrink-0 ${activity.bg}`}
          >
            {activity.img && (
              <img
                src={activity.img}
                alt={activity.alt}
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            {activity.icon && (
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-5xl opacity-50 group-hover:opacity-70 transition-opacity">
                {activity.icon}
              </div>
            )}
            <div class="absolute bottom-0 left-0 right-0 p-5 text-white">
              <h3 class="font-heading text-2xl font-bold uppercase tracking-wide mb-1">{activity.name}</h3>
              <p class="text-white/80 text-xs leading-relaxed font-sans">{activity.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- NEARBY ATTRACTIONS -->
  <section id="nearby" class="py-20 bg-white">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-heading text-5xl md:text-6xl font-bold uppercase tracking-wide text-charcoal mb-4">Explore the Lost Sierra</h2>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        {attractions.map((place) => (
          <div class={`relative overflow-hidden h-56 bg-gradient-to-br ${place.color} group`}>
            {place.img && (
              <img
                src={place.img}
                alt={place.alt}
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
              <p class="text-white/60 text-xs font-bold uppercase tracking-wider mb-1 font-sans">{place.distance} away</p>
              <h3 class="font-heading text-2xl font-bold uppercase tracking-wide mb-1">{place.name}</h3>
              <p class="text-white/80 text-sm leading-relaxed font-sans">{place.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- VIDEO -->
  <section class="bg-charcoal">
    <video
      src="https://beckwourthpeakhighcamp.com/wp-content/uploads/2025/03/High-Camp-on-mountain-Made-with-Clipchamp.mp4"
      autoplay
      muted
      loop
      playsinline
      class="w-full max-h-[70vh] object-cover"
    ></video>
  </section>

  <!-- TESTIMONIALS -->
  <section class="py-20 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-heading text-5xl md:text-6xl font-bold uppercase tracking-wide text-charcoal mb-4">What Guests Are Saying</h2>
        <div class="flex justify-center gap-1 text-gold text-xl">★★★★★</div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {testimonials.map((t) => (
          <div class="bg-white border border-charcoal/10 p-7 flex flex-col gap-4">
            <div class="text-gold text-lg">★★★★★</div>
            <p class="text-charcoal/80 leading-relaxed italic flex-1 font-sans">"{t.text}"</p>
            <div class="border-t border-charcoal/10 pt-4">
              <p class="font-heading text-lg font-bold uppercase tracking-wide text-charcoal">{t.name}</p>
              <p class="text-charcoal/50 text-sm font-sans">{t.unit}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PARTNER LOGOS -->
  <section class="py-12 bg-cream border-t border-charcoal/10">
    <div class="max-w-8xl mx-auto px-6">
      <p class="text-center text-charcoal/60 text-xs font-bold uppercase tracking-widest mb-7 font-sans">We Proudly Support</p>
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
        {partners.map((p) => (
          <img
            src={p.img}
            alt={p.name}
            class="h-14 w-auto object-contain opacity-80 hover:opacity-100 transition-opacity"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- INSTAGRAM -->
  <section class="py-20 bg-white">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-10">
        <h2 class="font-heading text-5xl font-bold uppercase tracking-wide text-charcoal mb-2">Follow Along</h2>
        <a
          href="https://www.instagram.com/beckwourthpeakhighcamp/"
          target="_blank"
          rel="noopener"
          class="text-cobalt font-bold hover:underline text-lg font-sans"
        >
          @beckwourthpeakhighcamp
        </a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 max-w-4xl mx-auto">
        {instagramPhotos.map((post) => (
          <a
            href={post.url}
            target="_blank"
            rel="noopener"
            class="block aspect-square overflow-hidden group"
          >
            <img
              src={post.img}
              alt={post.alt}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a
          href="https://www.instagram.com/beckwourthpeakhighcamp/"
          target="_blank"
          rel="noopener"
          class="inline-block border-2 border-cobalt text-cobalt hover:bg-cobalt hover:text-white font-bold px-7 py-3 rounded text-sm transition-colors uppercase tracking-wide font-heading"
        >
          View Our Instagram
        </a>
      </div>
    </div>
  </section>

  <Footer />

</Layout>
