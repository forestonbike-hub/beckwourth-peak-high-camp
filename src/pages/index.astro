---
import Layout from '../layouts/Layout.astro';

const BOOK_URL = 'https://resnexus.com/resnexus/reservations/book/6C664BF8-3F89-4D87-9E83-DA82447501EB/';
const WP = 'https://beckwourthpeakhighcamp.com/wp-content/uploads';

const lodging = [
  {
    name: 'North Cabin',
    sleeps: 4,
    desc: 'A modern cabin tucked into the pines with a wraparound deck and sweeping valley views.',
    img: `${WP}/2024/01/20230917_072055-edited.jpg`,
  },
  {
    name: 'South Cabin',
    sleeps: 4,
    desc: 'Wake up to panoramic mountain views. Adirondack chairs wait on the private deck.',
    img: `${WP}/2024/05/beckwourth-high-camp-3401-ig_53695282643_o-1-1024x1024.jpg`,
  },
  {
    name: 'The Yurt',
    sleeps: 5,
    desc: 'Hardwood floors, a queen bed, and a stargazing skylight — glamping at its best.',
    img: `${WP}/2025/07/20250608_090013-EDIT-1-1024x768.jpg`,
  },
  {
    name: 'Campsite',
    sleeps: 5,
    desc: 'Your own sheltered site with a fire ring, picnic table, and full access to all amenities.',
    img: `${WP}/2024/06/20240608_143013-1024x768.jpg`,
  },
];

const activities = [
  {
    name: 'Hiking',
    desc: 'On-property trails connect to miles of Forest Service singletrack. Summit Beckwourth Peak for 360° views.',
    img: `${WP}/2023/10/20220512_171221-1024x557.jpg`,
    bg: '',
  },
  {
    name: 'Biking',
    desc: 'Gravel routes and mountain bike trails leave right from camp. World-class terrain in every direction.',
    img: `${WP}/2024/05/5-bucks-gravel-24-3434-ig_53695515155_o-2-1024x1024.jpg`,
    bg: '',
  },
  {
    name: 'Disc Golf',
    desc: 'Play our on-property 20-basket disc golf course winding through the pines.',
    img: '',
    bg: 'bg-gradient-to-br from-charcoal to-[#2a2a2a]',
    icon: '🥏',
  },
  {
    name: 'Stargazing',
    desc: 'Far from city lights at 5,300 feet, the Milky Way puts on a show every clear night.',
    img: '',
    bg: 'bg-gradient-to-br from-[#0a0f2e] to-[#1a2550]',
    icon: '✦',
  },
  {
    name: 'Deck Time',
    desc: 'The shaded communal deck has picnic tables, string lights, and unobstructed mountain views.',
    img: `${WP}/2024/06/deck88-1024x769.jpg`,
    bg: '',
  },
  {
    name: 'Golf',
    desc: 'Championship courses at Graeagle Meadows and Plumas Pines are just 8 miles away.',
    img: '',
    bg: 'bg-gradient-to-br from-[#3a5c2a] to-[#2d4a20]',
    icon: '⛳',
  },
  {
    name: 'Campfires',
    desc: 'Gather around the communal fire pit under the stars. S\'mores provided.',
    img: '',
    bg: 'bg-gradient-to-br from-[#8B3A0F] to-[#5c2208]',
    icon: '🔥',
  },
];

const attractions = [
  {
    name: 'Lakes Basin',
    distance: '30 miles',
    desc: 'Crystal alpine lakes surrounded by granite peaks — one of the Sierra\'s best-kept secrets.',
    color: 'from-[#1a4a6b] to-[#0e3050]',
    img: 'https://upload.wikimedia.org/wikipedia/commons/2/21/Upper_Sardine_Lake_and_the_Sierra_Buttes%2C_California.jpg',
    credit: 'Dan Nevill / CC BY 2.0',
  },
  {
    name: 'Graeagle',
    distance: '8 miles',
    desc: 'A charming mountain village with golf, fishing, dining, and the famous Graeagle Flea Market.',
    color: 'from-[#4a5c2a] to-[#3a4a20]',
    img: '',
    credit: '',
  },
  {
    name: 'Frazier Falls',
    distance: '25 miles',
    desc: 'A 2-mile trail leads to a stunning 176-foot waterfall deep in Plumas National Forest.',
    color: 'from-[#1a5a4a] to-[#0e3a30]',
    img: 'https://upload.wikimedia.org/wikipedia/commons/5/54/Frazier_Creek_Falls_-_Plumas_National_Forest_-_California.jpg',
    credit: 'Jengod / CC BY-SA 4.0',
  },
  {
    name: 'Downieville',
    distance: '45 miles',
    desc: 'A historic Gold Rush town and world-renowned destination for mountain biking.',
    color: 'from-[#5c3a1a] to-[#3a2010]',
    img: 'https://upload.wikimedia.org/wikipedia/commons/8/83/Downieville_CA.jpg',
    credit: 'Ken Lund / CC BY-SA 2.0',
  },
  {
    name: 'Sierra Valley Preserve',
    distance: '20 miles',
    desc: 'One of the largest mountain meadows in the Sierra Nevada — a birding and wildlife paradise.',
    color: 'from-[#2a5c3a] to-[#1a3a25]',
    img: 'https://upload.wikimedia.org/wikipedia/commons/c/c7/Sierra_Valley_Ranchland_-_panoramio.jpg',
    credit: 'Annette Teng / CC BY 3.0',
  },
  {
    name: 'Portola Railroad Museum',
    distance: '6 miles',
    desc: 'Climb aboard and drive historic locomotives at the world\'s largest operating railroad museum.',
    color: 'from-[#4a2a5c] to-[#2a1a3a]',
    img: 'https://upload.wikimedia.org/wikipedia/commons/f/f6/The_Western_Pacific_Railroad_Museum_in_Portola%2C_CA_%2810143267775%29.jpg',
    credit: 'Mark Hogan / CC BY-SA 2.0',
  },
];

const testimonials = [
  {
    name: 'Ollie',
    text: 'You owe it to yourself to experience this place! Site and facilities are immaculate, with everything you\'d need. Views from the top of the ridge and from the cabins are magic. Best camp experience we\'ve had in CA.',
    unit: 'Cabin Guest',
  },
  {
    name: 'Matt',
    text: 'This off-grid tiny-home was exactly what we were looking for — comfortable with access to amazing trails. At night, the sky took center stage. There\'s little light pollution up here, so the Milky Way was on full display.',
    unit: 'Cabin Guest',
  },
  {
    name: 'Christa',
    text: 'An amazing spot for a bikepacking trip. Forest the host was awesome and made routes to optimize our trip. We stayed in the yurt and it was clean, spacious, well stocked and super comfy. Truly a bikepacking glamping experience.',
    unit: 'Yurt Guest',
  },
];

const partners = [
  'Sierra Buttes Trail Stewardship',
  'Beckwourth Peak Recreation',
  'Backcountry Discovery Routes',
  'Lost Sierra MTB',
  'Adventure Cycling Association',
];

const instagramPhotos = [
  { img: `${WP}/2024/05/beckwourth-high-camp-3380-ig_53695072201_o-1024x1024.jpg`, alt: 'High Camp cabin in the pines' },
  { img: `${WP}/2024/05/beckwourth-high-camp-3394-ig_53694184967_o-1024x1024.jpg`, alt: 'High Camp mountain views' },
  { img: `${WP}/2024/05/beckwourth-high-camp-3545-ig_53695282558_o-1-1024x1024.jpg`, alt: 'High Camp glamping' },
  { img: `${WP}/2024/05/5-bucks-gravel-24-3434-ig_53695515155_o-2-1024x1024.jpg`, alt: 'Gravel riding from High Camp' },
];
---

<Layout title="Beckwourth Peak High Camp | Off-Grid Glamping in the Lost Sierra">

  <!-- NAV -->
  <header class="sticky top-0 z-50 bg-dark-nav shadow-lg">
    <div class="max-w-8xl mx-auto px-6 flex items-center justify-between h-16">
      <a href="/" class="flex-shrink-0">
        <img
          src="https://beckwourthpeakhighcamp.com/wp-content/uploads/2023/02/Color-logo-no-background-stretched-png-250x81.jpg"
          alt="Beckwourth Peak High Camp"
          class="h-9 w-auto"
        />
      </a>
      <nav class="hidden md:flex items-center gap-8 text-sm font-sans text-white/80">
        <a href="#lodging" class="hover:text-white transition-colors">Lodging</a>
        <a href="#activities" class="hover:text-white transition-colors">Things To Do</a>
        <a href="#nearby" class="hover:text-white transition-colors">Explore</a>
        <a href="https://beckwourthpeakhighcamp.com/getting-here/" class="hover:text-white transition-colors">Getting Here</a>
      </nav>
      <a
        href={BOOK_URL}
        target="_blank"
        rel="noopener"
        class="bg-cobalt hover:bg-blue-600 text-white text-sm font-bold px-5 py-2 rounded-full transition-colors"
      >
        Book Now
      </a>
    </div>
  </header>

  <!-- HERO -->
  <section class="relative h-screen min-h-[600px] flex items-center justify-center overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat"
      style={`background-image: url('${WP}/2024/05/beckwourth-high-camp-3379-ig_53695514700_o-2-1024x1024.jpg')`}
    ></div>
    <div class="absolute inset-0 bg-black/45"></div>
    <div class="relative z-10 text-center text-white px-6 max-w-3xl mx-auto">
      <p class="text-gold text-sm font-sans font-bold uppercase tracking-widest mb-4">Lost Sierra, California</p>
      <h1 class="font-heading text-5xl md:text-6xl lg:text-7xl font-bold leading-tight mb-6">
        Your Base Camp<br />in the Lost Sierra
      </h1>
      <p class="text-lg md:text-xl text-white/90 mb-8 leading-relaxed max-w-xl mx-auto">
        Off-grid glamping on 60 acres in Plumas National Forest. Hot showers, mountain views, and trails out your door.
      </p>
      <a
        href={BOOK_URL}
        target="_blank"
        rel="noopener"
        class="inline-block bg-cobalt hover:bg-blue-600 text-white font-bold px-8 py-4 rounded-full text-lg transition-colors"
      >
        Check Availability
      </a>
    </div>
  </section>

  <!-- STATS BAR -->
  <section class="bg-charcoal text-white py-5">
    <div class="max-w-8xl mx-auto px-6">
      <ul class="flex flex-wrap items-center justify-center gap-x-0 gap-y-2 text-sm font-sans font-bold uppercase tracking-wider">
        <li class="px-6 border-r border-white/20 text-center">60 Acres</li>
        <li class="px-6 border-r border-white/20 text-center">5,300 ft Elevation</li>
        <li class="px-6 border-r border-white/20 text-center">Hot Showers</li>
        <li class="px-6 border-r border-white/20 text-center">Starlink WiFi</li>
        <li class="px-6 text-center text-gold">360° Views</li>
      </ul>
    </div>
  </section>

  <!-- LODGING -->
  <section id="lodging" class="py-20 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-charcoal mb-4">Where You'll Stay</h2>
        <p class="text-charcoal/70 text-lg max-w-xl mx-auto">
          Four unique accommodations, each with private space and access to shared amenities.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {lodging.map((unit) => (
          <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-shadow group">
            <div class="relative h-52 overflow-hidden">
              <img
                src={unit.img}
                alt={unit.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-5 flex flex-col gap-3">
              <div>
                <h3 class="font-heading text-xl font-bold text-charcoal">{unit.name}</h3>
                <p class="text-cobalt text-sm font-bold mt-0.5">Sleeps {unit.sleeps}</p>
              </div>
              <p class="text-charcoal/70 text-sm leading-relaxed flex-1">{unit.desc}</p>
              <a
                href={BOOK_URL}
                target="_blank"
                rel="noopener"
                class="block text-center bg-cobalt hover:bg-blue-600 text-white font-bold py-2.5 rounded-full text-sm transition-colors mt-1"
              >
                Book This Unit
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ACTIVITIES -->
  <section id="activities" class="py-20 bg-white">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-charcoal mb-4">Things To Do</h2>
        <p class="text-charcoal/70 text-lg max-w-xl mx-auto">
          From dawn rides to late-night fires, there's no shortage of ways to fill your days.
        </p>
      </div>
      <div class="flex flex-wrap justify-center gap-5">
        {activities.map((activity) => (
          <div
            class={`relative rounded-2xl overflow-hidden w-full sm:w-[calc(50%-10px)] lg:w-[calc(25%-15px)] min-w-[220px] max-w-[300px] h-64 group cursor-default flex-shrink-0 ${activity.bg}`}
          >
            {activity.img && (
              <img
                src={activity.img}
                alt={activity.name}
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            {activity.icon && (
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-5xl opacity-60 group-hover:opacity-80 transition-opacity">
                {activity.icon}
              </div>
            )}
            <div class="absolute bottom-0 left-0 right-0 p-5 text-white">
              <h3 class="font-heading text-xl font-bold mb-1">{activity.name}</h3>
              <p class="text-white/80 text-xs leading-relaxed">{activity.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="py-20 bg-charcoal text-white">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-heading text-4xl md:text-5xl font-bold mb-4">What Guests Are Saying</h2>
        <div class="flex justify-center gap-1 text-gold text-xl">
          {'★★★★★'}
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {testimonials.map((t) => (
          <div class="bg-white/10 rounded-2xl p-7 flex flex-col gap-4">
            <div class="text-gold text-lg">★★★★★</div>
            <p class="text-white/90 leading-relaxed italic flex-1">"{t.text}"</p>
            <div>
              <p class="font-bold text-white">{t.name}</p>
              <p class="text-white/50 text-sm">{t.unit}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- NEARBY ATTRACTIONS -->
  <section id="nearby" class="py-20 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-charcoal mb-4">Explore the Lost Sierra</h2>
        <p class="text-charcoal/70 text-lg max-w-xl mx-auto">
          High Camp puts you in the middle of one of California's most underrated regions.
        </p>
      </div>
      <!-- Photos coming soon — placeholder cards for now -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {attractions.map((place) => (
          <div class={`relative rounded-2xl overflow-hidden h-56 bg-gradient-to-br ${place.color} group`}>
            {place.img && (
              <img
                src={place.img}
                alt={place.name}
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
              <p class="text-white/60 text-xs font-bold uppercase tracking-wider mb-1">{place.distance} away</p>
              <h3 class="font-heading text-2xl font-bold mb-1.5">{place.name}</h3>
              <p class="text-white/80 text-sm leading-relaxed">{place.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="text-center text-charcoal/30 text-xs mt-4">
        Photo credits: Dan Nevill / CC BY 2.0, Jengod / CC BY-SA 4.0, Ken Lund / CC BY-SA 2.0, Annette Teng / CC BY 3.0, Mark Hogan / CC BY-SA 2.0
      </p>
    </div>
  </section>

  <!-- PARTNER LOGOS -->
  <section class="py-12 bg-white border-t border-charcoal/10">
    <div class="max-w-8xl mx-auto px-6">
      <p class="text-center text-charcoal/50 text-xs font-bold uppercase tracking-widest mb-7">We Proudly Support</p>
      <div class="flex flex-wrap items-center justify-center gap-6 md:gap-10">
        {partners.map((p) => (
          <span class="text-charcoal/40 text-sm font-bold uppercase tracking-wide text-center">{p}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- INSTAGRAM -->
  <section class="py-20 bg-cream">
    <div class="max-w-8xl mx-auto px-6">
      <div class="text-center mb-10">
        <h2 class="font-heading text-4xl font-bold text-charcoal mb-2">Follow Along</h2>
        <a
          href="https://www.instagram.com/beckwourthpeakhighcamp/"
          target="_blank"
          rel="noopener"
          class="text-cobalt font-bold hover:underline text-lg"
        >
          @beckwourthpeakhighcamp
        </a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 max-w-4xl mx-auto">
        {instagramPhotos.map((post) => (
          <a
            href="https://www.instagram.com/beckwourthpeakhighcamp/"
            target="_blank"
            rel="noopener"
            class="block aspect-square overflow-hidden rounded-xl group"
          >
            <img
              src={post.img}
              alt={post.alt}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a
          href="https://www.instagram.com/beckwourthpeakhighcamp/"
          target="_blank"
          rel="noopener"
          class="inline-block border-2 border-cobalt text-cobalt hover:bg-cobalt hover:text-white font-bold px-7 py-3 rounded-full text-sm transition-colors"
        >
          View Our Instagram
        </a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="bg-dark-nav text-white py-14">
    <div class="max-w-8xl mx-auto px-6">
      <div class="flex flex-col md:flex-row justify-between gap-10 mb-10">
        <div class="max-w-xs">
          <img
            src="https://beckwourthpeakhighcamp.com/wp-content/uploads/2023/02/Color-logo-no-background-stretched-png-250x81.jpg"
            alt="Beckwourth Peak High Camp"
            class="h-10 w-auto mb-4"
          />
          <p class="text-white/60 text-sm leading-relaxed">
            Off-grid glamping on 60 acres in California's Lost Sierra. Seasonal operation, May through October.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-10 text-sm">
          <div>
            <p class="font-bold uppercase tracking-wider text-white/40 text-xs mb-4">Stay</p>
            <ul class="space-y-2 text-white/70">
              <li><a href={BOOK_URL} target="_blank" rel="noopener" class="hover:text-white transition-colors">North Cabin</a></li>
              <li><a href={BOOK_URL} target="_blank" rel="noopener" class="hover:text-white transition-colors">South Cabin</a></li>
              <li><a href={BOOK_URL} target="_blank" rel="noopener" class="hover:text-white transition-colors">The Yurt</a></li>
              <li><a href={BOOK_URL} target="_blank" rel="noopener" class="hover:text-white transition-colors">Campsite</a></li>
            </ul>
          </div>
          <div>
            <p class="font-bold uppercase tracking-wider text-white/40 text-xs mb-4">Visit</p>
            <ul class="space-y-2 text-white/70">
              <li><a href="https://beckwourthpeakhighcamp.com/getting-here/" class="hover:text-white transition-colors">Getting Here</a></li>
              <li><a href="https://beckwourthpeakhighcamp.com/policies/" class="hover:text-white transition-colors">Policies</a></li>
              <li>
                <a href="https://www.instagram.com/beckwourthpeakhighcamp/" target="_blank" rel="noopener" class="hover:text-white transition-colors">
                  Instagram
                </a>
              </li>
              <li>
                <a href="mailto:highcampbeckwourth@gmail.com" class="hover:text-white transition-colors">Contact</a>
              </li>
            </ul>
          </div>
        </div>
        <div class="max-w-xs">
          <p class="font-bold uppercase tracking-wider text-white/40 text-xs mb-4">Ready to Book?</p>
          <p class="text-white/60 text-sm mb-4">Check availability across all four units and reserve your dates.</p>
          <a
            href={BOOK_URL}
            target="_blank"
            rel="noopener"
            class="inline-block bg-cobalt hover:bg-blue-600 text-white font-bold px-6 py-3 rounded-full text-sm transition-colors"
          >
            Check Availability
          </a>
        </div>
      </div>
      <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-white/30">
        <p>&copy; {new Date().getFullYear()} Beckwourth Peak High Camp. All rights reserved.</p>
        <p>Near Portola, CA &bull; Plumas National Forest &bull; Lost Sierra</p>
      </div>
    </div>
  </footer>

</Layout>
