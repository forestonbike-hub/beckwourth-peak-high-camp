            <img
              src={post.img}
              alt={post.alt}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a
          href="https://www.instagram.com/beckwourthpeakhighcamp/"
          target="_blank"
          rel="noopener"
          class="inline-block border-2 border-cobalt text-cobalt hover:bg-cobalt hover:text-white font-bold px-7 py-3 rounded text-sm transition-colors uppercase tracking-wide font-heading"
